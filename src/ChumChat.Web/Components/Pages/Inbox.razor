    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthState.GetAuthenticationStateAsync();
        var user = authState.User;
        int.TryParse(user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out currentStaffId);
        currentStaffName = user.Identity?.Name ?? "Nhân viên";
        isAdmin = user.IsInRole("Admin");

        staff = (await StaffSvc.GetAllAsync()).Where(s => s.IsActive).ToList();
        staffNames = staff.ToDictionary(s => s.Id, s => s.DisplayName);
        quickReplies = await QuickReplies.GetAllAsync();
        allProducts = await InboxSvc.GetAllProductsAsync();

        Events.Changed += OnInboxChanged;
        await ReloadAsync();

        // Tự động làm mới định kỳ (dự phòng khi tín hiệu realtime không tới) — cứ 6 giây tải lại
        _ = PollLoopAsync(pollCts.Token);
    }

    private async Task PollLoopAsync(CancellationToken ct)
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(6));
            while (await timer.WaitForNextTickAsync(ct))
            {
                await InvokeAsync(async () =>
                {
                    await ReloadAsync();
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException) { /* rời trang */ }
    }

    private void OnInboxChanged()
    {
        // Sự kiện đến từ thread webhook → phải nhảy về sync context của circuit
        _ = InvokeAsync(async () =>
        {
            await ReloadAsync();
            StateHasChanged();
        });
    }

    private async Task ReloadAsync()
    {
        conversations = await InboxSvc.GetConversationsAsync(filter, mineOnly ? currentStaffId : null);
        selected = conversations.FirstOrDefault(c => c.Id == selectedId);
        if (selected is not null)
        {
            // Hội thoại đang mở trước mắt nhân viên → tin mới coi như đã đọc
            if (selected.UnreadCount > 0)
            {
                await InboxSvc.MarkReadAsync(selected.Id);
                selected.UnreadCount = 0;
            }
            messages = await InboxSvc.GetMessagesAsync(selected.Id);
            orders = await InboxSvc.GetOrdersAsync(selected.Id);
        }
    }

