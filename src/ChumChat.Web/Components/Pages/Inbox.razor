    private void AddProductToOrder(Product p)
    {
        var existing = orderItems.FirstOrDefault(i => i.Name == p.Name);
        if (existing is not null)
            existing.Quantity++;
        else
            orderItems.Add(new OrderFormItem { Name = p.Name, UnitPrice = p.Price, Quantity = 1 });
        productSearch = "";
    }

