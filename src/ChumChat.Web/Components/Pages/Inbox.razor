    private void UpdateFullAddress()
    {
        var pName = provinces.FirstOrDefault(p => p.Code == selectedProvinceCode)?.Name ?? "";
        var dName = districts.FirstOrDefault(d => d.Code == selectedDistrictCode)?.Name ?? "";
        var wName = wards.FirstOrDefault(w => w.Code == selectedWardCode)?.Name ?? "";
        
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(streetAddress)) parts.Add(streetAddress.Trim());
        if (!string.IsNullOrWhiteSpace(wName)) parts.Add(wName);
        if (!string.IsNullOrWhiteSpace(dName)) parts.Add(dName);
        if (!string.IsNullOrWhiteSpace(pName)) parts.Add(pName);
        
        ahaMoveReceiverAddress = string.Join(", ", parts);
        ahaMoveEstimatedFee = null; // reset fee
        suggestedLat = null;
        suggestedLng = null;
    }

