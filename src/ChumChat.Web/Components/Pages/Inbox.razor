@page "/"
@attribute [Authorize]
@rendermode InteractiveServer
@using System.Text.Json
@using ChumChat.Web.Data
@using ChumChat.Web.Services
@inject InboxService InboxSvc
@inject InboxEvents Events
@inject TrelloService Trello
@inject StaffService StaffSvc
@inject QuickReplyService QuickReplies
@inject AiSuggestionService Ai
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Nav
@inject IWebHostEnvironment HostEnv
@inject IJSRuntime JS
@inject PushNotificationService PushSvc
@inject ChannelSettingsStore Store
@inject AhaMoveService AhaMoveSvc
@implements IDisposable

<PageTitle>ChumChat — Hộp thư hợp nhất</PageTitle>

<div class="inbox @(selected is not null ? "has-selection" : "") @(mobileShowCustomerPanel ? "show-info-drawer" : "")">
    <aside class="conversation-list">
        <div class="list-header">
            <h1>ChumChat</h1>
            <span class="header-links">
                <a class="simulator-link" href="/simulator" title="Giả lập tin nhắn để test">🧪 Giả lập</a>
                @if (isAdmin)
                {
                    <a class="simulator-link" href="/tro-ly-ai" title="Cấu hình trợ lý AI">✨ Trợ lý AI</a>
                    <a class="simulator-link" href="/settings" title="Cấu hình kết nối các kênh">⚙ Cấu hình</a>
                }
            </span>
        </div>

        <div class="me-bar">
            <span class="me-name">👤 @currentStaffName</span>
            <span class="me-links">
                <button class="push-toggle-btn" @onclick="TogglePushSubscription" title="@(pushSubscribed ? "Tắt thông báo đẩy trên thiết bị này" : "Bật thông báo đẩy trên thiết bị này")">
                    @(pushSubscribed ? "🔔" : "🔕")
                </button>
                <a href="/doi-mat-khau" title="Đổi mật khẩu">🔑</a>
                <a class="logout-link" href="/account/logout" title="Đăng xuất">Đăng xuất</a>
            </span>
        </div>
        @if (!string.IsNullOrEmpty(pushError))
        {
            <div class="push-error-bar" title="@pushError">✕ Lỗi thông báo (di chuột xem)</div>
        }

        <div class="channel-filters">
            <button class="@(mineOnly ? "filter" : "filter active")" @onclick="() => SetMineOnly(false)">Tất cả</button>
            <button class="@(mineOnly ? "filter active" : "filter")" @onclick="() => SetMineOnly(true)">Của tôi</button>
        </div>
        <div class="channel-filters">
            <button class="@FilterClass(null)" @onclick="() => SetFilter(null)">Mọi kênh</button>
            @foreach (var channel in Enum.GetValues<ChannelType>())
            {
                <button class="@FilterClass(channel)" @onclick="() => SetFilter(channel)">
                    @ChannelLabel(channel)
                </button>
            }
        </div>

        @if (conversations.Count == 0)
        {
            <div class="empty-list">
                <p>Chưa có hội thoại nào.</p>
                <p>Vào trang <a href="/simulator">Giả lập</a> để tạo tin nhắn thử, hoặc cấu hình webhook các kênh (xem README).</p>
            </div>
        }
        else
        {
            <div class="items">
                @foreach (var conv in conversations)
                {
                    <div class="item @(conv.Id == selectedId ? "selected" : "")"
                         @onclick="() => SelectConversation(conv.Id)">
                        <div class="item-avatar">
                            @if (!string.IsNullOrEmpty(conv.AvatarUrl))
                            {
                                <img src="@conv.AvatarUrl" alt="" loading="lazy" />
                            }
                            else
                            {
                                <span class="avatar-fallback @ChannelCss(conv.Channel)">@Initial(conv.CustomerName)</span>
                            }
                            <span class="channel-dot @ChannelCss(conv.Channel)" title="@ChannelLabel(conv.Channel)"></span>
                        </div>
                        <div class="item-body">
                            <div class="item-top">
                                <span class="name">@conv.CustomerName</span>
                                <span class="time">@FormatTime(conv.LastMessageAt)</span>
                            </div>
                            <div class="item-bottom">
                                <span class="preview">@conv.LastMessagePreview</span>
                                @if (!string.IsNullOrEmpty(conv.Tag))
                                {
                                    <span class="tag @TagCss(conv.Tag)">@conv.Tag</span>
                                }
                                @if (conv.UnreadCount > 0)
                                {
                                    <span class="unread">@conv.UnreadCount</span>
                                }
                            </div>
                            @if (conv.AssignedStaffId is int sid && staffNames.TryGetValue(sid, out var an))
                            {
                                <div class="item-assignee">👤 @an</div>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </aside>

    <section class="chat-pane">
        @if (selected is null)
        {
            <div class="no-selection">
                <p>💬 Chọn một hội thoại để bắt đầu trả lời khách</p>
            </div>
        }
        else
        {
            <header class="chat-header">
                <button class="mobile-back-btn" @onclick="DeselectConversation" title="Quay lại danh sách">⬅</button>
                <span class="channel-badge @ChannelCss(selected.Channel)">@ChannelLabel(selected.Channel)</span>
                <span class="chat-name">@selected.CustomerName</span>

                <select class="tag-select @TagCss(selected.Tag)" value="@selected.Tag"
                        @onchange="@(e => SetTag(e.Value?.ToString() ?? ""))">
                    <option value="">— gắn thẻ —</option>
                    @foreach (var tag in TagPresets)
                    {
                        <option value="@tag">@tag</option>
                    }
                </select>

                <select class="assign-select" value="@(selected.AssignedStaffId?.ToString() ?? "")"
                        @onchange="@(e => AssignTo(e.Value?.ToString()))" title="Phân công nhân viên phụ trách">
                    <option value="">— chưa phân công —</option>
                    @foreach (var s in staff)
                    {
                        <option value="@s.Id">@s.DisplayName</option>
                    }
                </select>

                <button class="trello-btn" title="Tạo thẻ Trello từ hội thoại này (khi chốt đơn xong)"
                        @onclick="OpenTrelloModal">
                    📋 Tạo thẻ Trello
                </button>
                <button class="mobile-info-btn" @onclick="() => mobileShowCustomerPanel = true" title="Thông tin & Đơn hàng">👤</button>

                @if (trelloNote is not null)
                {
                    <span class="trello-note @(trelloNoteIsError ? "error" : "")">
                        @if (trelloCardUrl is not null)
                        {
                            <a href="@trelloCardUrl" target="_blank">@trelloNote</a>
                        }
                        else
                        {
                            @trelloNote
                        }
                    </span>
                }

                @if (!InboxSvc.IsChannelConfigured(selected.Channel))
                {
                    <span class="not-configured" title="Vào trang Cấu hình để kết nối kênh này">
                        Kênh chưa kết nối — trả lời chỉ hiện trong app
                    </span>
                }
            </header>

            <div class="messages" id="messages">
                @foreach (var msg in messages)
                {
                    <div class="bubble-row @(msg.Direction == MessageDirection.Outbound ? "out" : "in")">
                        <div class="bubble">
                            @if (msg.AttachmentUrl is not null)
                            {
                                @if (IsImageUrl(msg.AttachmentUrl))
                                {
                                    <a href="@msg.AttachmentUrl" target="_blank">
                                        <img class="bubble-img" src="@msg.AttachmentUrl" loading="lazy" alt="Ảnh đính kèm" />
                                    </a>
                                }
                                else
                                {
                                    <a class="bubble-file" href="@msg.AttachmentUrl" target="_blank">📎 Mở file đính kèm</a>
                                }
                            }
                            @if (!string.IsNullOrEmpty(msg.Text))
                            {
                                <div class="bubble-text">@msg.Text</div>
                            }
                            <div class="bubble-meta">
                                @msg.SentAt.ToLocalTime().ToString("HH:mm dd/MM")
                                @if (msg.Status == MessageStatus.Failed)
                                {
                                    <span class="status failed">✕ Gửi lỗi</span>
                                }
                                else if (msg.Status == MessageStatus.Simulated)
                                {
                                    <span class="status simulated">giả lập</span>
                                }
                            </div>
                            @if (msg.Status == MessageStatus.Failed && !string.IsNullOrEmpty(msg.Error))
                            {
                                <div class="bubble-error">@msg.Error</div>
                            }
                        </div>
                    </div>
                }

                <button class="scroll-to-bottom-btn" @onclick="ScrollToBottomAsync" title="Cuộn xuống cuối">⬇️</button>
            </div>

            @if (quickReplies.Count > 0 || Ai.IsConfigured)
            {
                <div class="quick-bar">
                    @if (Ai.IsConfigured)
                    {
                        <button class="ai-chip" @onclick="SuggestWithAi" disabled="@aiLoading"
                                title="Nhờ AI soạn câu trả lời dựa trên hội thoại">
                            @(aiLoading ? "✨ Đang nghĩ…" : "✨ Gợi ý AI")
                        </button>
                    }
                    @foreach (var qr in quickReplies)
                    {
                        <button class="quick-chip" title="@qr.Content" @onclick="() => InsertQuickReply(qr.Content)">
                            @qr.Title
                        </button>
                    }
                    @if (aiError is not null)
                    {
                        <span class="ai-error">✕ @aiError</span>
                    }
                </div>
            }
            <footer class="composer">
                <label class="attach-btn" title="Gửi ảnh cho khách">
                    📎
                    <InputFile OnChange="OnImageSelected" accept="image/*" disabled="@sending" />
                </label>
                <textarea @bind="draft" @bind:event="oninput" @onkeydown="OnComposerKeyDown"
                          placeholder="Nhập tin trả lời… (Enter để gửi, Shift+Enter xuống dòng)"
                          disabled="@sending"></textarea>
                <button @onclick="SendAsync" disabled="@(sending || string.IsNullOrWhiteSpace(draft))">
                    @(sending ? "Đang gửi…" : "Gửi")
                </button>
            </footer>
        }
    </section>

    @* ===== Cột phải: thông tin khách + tạo đơn hàng ===== *@
    @if (selected is not null)
    {
        <aside class="customer-panel">
            <button class="mobile-close-drawer-btn" @onclick="() => mobileShowCustomerPanel = false">✕ Đóng</button>
            <div class="panel-tabs">
                <button class="panel-tab @(activeTab == "info" ? "active" : "")"
                        @onclick='() => activeTab = "info"'>Thông tin</button>
                <button class="panel-tab tab-order @(activeTab == "order" ? "active" : "")"
                        @onclick='() => activeTab = "order"'>Tạo đơn</button>
            </div>

            @if (activeTab == "info")
            {
                <div class="panel-section">
                    <h3>Khách hàng</h3>
                    <div class="panel-customer">
                        <div class="panel-avatar">
                            @if (!string.IsNullOrEmpty(selected.AvatarUrl))
                            {
                                <img src="@selected.AvatarUrl" alt="" />
                            }
                            else
                            {
                                <span class="avatar-fallback @ChannelCss(selected.Channel)">@Initial(selected.CustomerName)</span>
                            }
                        </div>
                        <div class="panel-name">@selected.CustomerName</div>
                        <span class="channel-badge @ChannelCss(selected.Channel)">@ChannelLabel(selected.Channel)</span>
                        @if (!string.IsNullOrEmpty(selected.Tag))
                        {
                            <span class="tag @TagCss(selected.Tag)">@selected.Tag</span>
                        }
                        <div class="panel-assignee">
                            Phụ trách:
                            @if (selected.AssignedStaffId is int aid && staffNames.TryGetValue(aid, out var an))
                            {
                                <b>@an</b>
                            }
                            else
                            {
                                <span class="muted">chưa phân công</span>
                            }
                        </div>
                    </div>
                </div>

                <div class="panel-section orders-section">
                    <h3>Lịch sử đặt hàng <span class="order-count">@orders.Count</span></h3>
                    @if (orders.Count == 0)
                    {
                        <p class="panel-empty">Chưa có đơn nào.</p>
                    }
                    else
                    {
                        <div class="order-list">
                            @foreach (var order in orders)
                            {
                                <div class="order-item">
                                    <div class="order-top">
                                        <span class="order-title">@order.Title</span>
                                        @if (order.Amount > 0)
                                        {
                                            <span class="order-amount">@order.Amount.ToString("N0")đ</span>
                                        }
                                    </div>
                                    <div class="order-meta">
                                        @order.CreatedAt.ToLocalTime().ToString("HH:mm dd/MM/yyyy")
                                        @if (order.TrelloCardUrl is not null)
                                        {
                                            <a href="@order.TrelloCardUrl" target="_blank">Trello ↗</a>
                                        }
                                        @if (!string.IsNullOrEmpty(order.AhamoveTrackingLink))
                                        {
                                            <a href="@order.AhamoveTrackingLink" target="_blank" class="ahamove-link">🏍 Theo dõi AhaMove ↗</a>
                                        }
                                        else if (!string.IsNullOrEmpty(order.AhamoveOrderId))
                                        {
                                            <span class="ahamove-status">🏍 Đã đặt xe (@order.AhamoveOrderId)</span>
                                        }
                                    </div>
                                    @if (string.IsNullOrEmpty(order.AhamoveOrderId) && Store.AhaMove.Token != "")
                                    {
                                        <button class="btn-ahamove" @onclick="() => OpenAhaMoveModal(order)" style="background: #ea5800; color: white; border: none; border-radius: 4px; padding: 4px 8px; font-size: 11px; cursor: pointer; margin-bottom: 5px;">
                                            🏍 Đặt giao hàng AhaMove
                                        </button>
                                    }
                                    @if (order.Items.Count > 0)
                                    {
                                        <div class="order-items-summary">
                                            @foreach (var oi in order.Items)
                                            {
                                                <span class="order-item-line">@oi.ProductName ×@oi.Quantity</span>
                                            }
                                        </div>
                                    }
                                    @if (!string.IsNullOrEmpty(order.Note))
                                    {
                                        <div class="order-note">@order.Note</div>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="order-form">
                    <div class="order-form-scroll">
                        @* --- Khách hàng --- *@
                        <div class="form-section">
                            <h3>👤 Khách hàng</h3>
                            <div class="form-fields">
                                <div class="form-row customer-name-row">
                                    <span class="customer-tag">@selected.CustomerName</span>
                                    <span class="channel-badge sm @ChannelCss(selected.Channel)">@ChannelLabel(selected.Channel)</span>
                                </div>
                                <input @bind="orderPhone" placeholder="Số điện thoại" class="form-input" />
                                <input @bind="orderAddress" placeholder="Địa chỉ giao hàng" class="form-input" />
                            </div>
                        </div>

                        @* --- Sản phẩm --- *@
                        <div class="form-section">
                            <h3>📦 Sản phẩm</h3>
                            @if (orderItems.Count > 0)
                            {
                                <table class="product-table">
                                    <thead>
                                        <tr>
                                            <th>Tên SP</th>
                                            <th>SL</th>
                                            <th>Đơn giá</th>
                                            <th>Thành tiền</th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in orderItems)
                                        {
                                            <tr>
                                                <td class="cell-name">@item.Name</td>
                                                <td><input type="number" @bind="item.Quantity" min="1" class="qty-input" /></td>
                                                <td class="cell-price">@item.UnitPrice.ToString("N0")</td>
                                                <td class="cell-total">@((item.Quantity * item.UnitPrice).ToString("N0"))</td>
                                                <td><button class="remove-item" @onclick="() => orderItems.Remove(item)">✕</button></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }
                            else
                            {
                                <div class="empty-products">
                                    <div class="empty-icon">📦</div>
                                    <p>Chưa có sản phẩm nào</p>
                                </div>
                            }

                            <div class="product-search-bar">
                                <input @bind="productSearch" @bind:event="oninput"
                                       placeholder="🔍 Tìm kiếm sản phẩm" class="form-input" />
                                <button class="btn-add-inline" @onclick="ToggleAddProduct"
                                        title="Thêm sản phẩm mới">+</button>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(productSearch))
                            {
                                <div class="product-dropdown">
                                    @{ var filtered = FilteredProducts.ToList(); }
                                    @if (filtered.Count > 0)
                                    {
                                        @foreach (var p in filtered)
                                        {
                                            <div class="product-option" @onclick="() => AddProductToOrder(p)">
                                                <span>@p.Name</span>
                                                <span class="product-opt-price">@p.Price.ToString("N0")đ</span>
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <div class="product-option no-result">Không tìm thấy</div>
                                    }
                                </div>
                            }

                            @if (showAddProductForm)
                            {
                                <div class="add-product-inline">
                                    <input @bind="newProductName" placeholder="Tên sản phẩm" class="form-input" />
                                    <input type="number" @bind="newProductPrice" placeholder="Giá" class="form-input" />
                                    <div class="add-product-actions">
                                        <button class="btn-small-save" @onclick="SaveNewProduct"
                                                disabled="@string.IsNullOrWhiteSpace(newProductName)">Thêm vào đơn</button>
                                        <button class="btn-small-cancel" @onclick="() => showAddProductForm = false">Hủy</button>
                                    </div>
                                </div>
                            }
                        </div>

                        @* --- Thanh toán --- *@
                        <div class="form-section">
                            <h3>💳 Thanh toán</h3>
                            <select @bind="orderPayment" class="form-input">
                                <option value="COD">COD (thu hộ)</option>
                                <option value="Chuyển khoản">Chuyển khoản</option>
                                <option value="Tiền mặt">Tiền mặt</option>
                            </select>

                            <div class="order-summary">
                                <div class="summary-row">
                                    <span>Tổng giá trị đơn hàng</span>
                                    <span class="summary-value">@ItemsTotal.ToString("N0") đ</span>
                                </div>
                                <div class="summary-row">
                                    <span>Phí vận chuyển</span>
                                    <div class="summary-input-wrap">
                                        <input type="number" @bind="orderShipping" class="summary-input" />
                                        <span>đ</span>
                                    </div>
                                </div>
                                <div class="summary-row">
                                    <span>Giảm giá</span>
                                    <div class="summary-input-wrap">
                                        <input type="number" @bind="orderDiscount" class="summary-input" />
                                        <span>đ</span>
                                    </div>
                                </div>
                                <div class="summary-row total-row">
                                    <span>Tổng thanh toán</span>
                                    <span class="summary-grand-total">@OrderGrandTotal.ToString("N0") đ</span>
                                </div>
                            </div>

                            <textarea @bind="orderNote" placeholder="Ghi chú nội bộ…" rows="2"
                                      class="form-input form-textarea"></textarea>
                        </div>
                    </div>

                    @if (orderFormError is not null)
                    {
                        <div class="order-form-msg error">✕ @orderFormError</div>
                    }
                    @if (orderFormSuccess is not null)
                    {
                        <div class="order-form-msg success">✔ @orderFormSuccess</div>
                    }

                    <div class="order-form-actions">
                        <button class="btn-reset" @onclick="ResetOrderForm" disabled="@creatingOrder">Thiết lập lại</button>
                        <button class="btn-create-order" @onclick="SubmitOrderAsync"
                                disabled="@(creatingOrder || orderItems.Count == 0)">
                            @(creatingOrder ? "Đang tạo…" : "Tạo đơn")
                        </button>
                    </div>
                </div>
            }
        </aside>
    }
</div>

@* ===== Popup xem trước thẻ Trello ===== *@
@if (showTrelloModal && selected is not null)
{
    <div class="modal-overlay" @onclick="CloseTrelloModal">
        <div class="modal" @onclick:stopPropagation="true">
            <h2>📋 Xem trước thẻ Trello</h2>
            <label class="modal-label">
                Tên thẻ
                <input @bind="trelloName" />
            </label>
            <label class="modal-label">
                Nội dung
                <textarea @bind="trelloDesc" rows="12"></textarea>
            </label>
            @if (trelloModalError is not null)
            {
                <p class="modal-error">✕ @trelloModalError</p>
            }
            <div class="modal-actions">
                <button class="modal-cancel" @onclick="CloseTrelloModal" disabled="@creatingCard">Hủy</button>
                <button class="modal-create" @onclick="ConfirmCreateTrelloCard"
                        disabled="@creatingCard">@(creatingCard ? "Đang tạo..." : "Tạo thẻ")</button>
            </div>
        </div>
    </div>
}

@if (showAhaMoveModal && selectedOrderForAhaMove is not null)
{
    <div class="modal-overlay" @onclick="CloseAhaMoveModal">
        <div class="modal" @onclick:stopPropagation="true">
            <h3 style="margin-top:0; color:#ea5800;">🏍 Xác nhận gọi AhaMove</h3>
            <label class="modal-label">Tên khách nhận
                <input @bind="ahaMoveReceiverName" />
            </label>
            <label class="modal-label">SĐT nhận
                <input @bind="ahaMoveReceiverMobile" />
            </label>
            <label class="modal-label">Địa chỉ nhận
                <textarea @bind="ahaMoveReceiverAddress" rows="2"></textarea>
            </label>
            <label class="modal-label">Thu hộ (COD) đ
                <input type="number" @bind="ahaMoveCod" />
            </label>
            @if (ahaMoveEstimatedFee is not null)
            {
                <div style="margin-top: 10px; padding: 10px; background: #fff3ed; border-radius: 6px; text-align: center;">
                    <span style="color: #666;">Phí giao hàng dự kiến:</span><br/>
                    <strong style="color: #ea5800; font-size: 1.4em;">@ahaMoveEstimatedFee?.ToString("N0") đ</strong>
                </div>
            }
            @if (ahaMoveModalError is not null)
            {
                <p class="modal-error">✕ @ahaMoveModalError</p>
            }
            <div class="modal-actions">
                <button class="modal-cancel" @onclick="CloseAhaMoveModal" disabled="@(creatingAhaMove || estimatingAhaMove)">Hủy</button>
                
                @if (ahaMoveEstimatedFee is null)
                {
                    <button class="modal-create" @onclick="EstimateAhaMoveFee"
                            disabled="@estimatingAhaMove" style="background: #28a745; border-color: #28a745;">
                        @(estimatingAhaMove ? "Đang tính..." : "Tính phí giao hàng")
                    </button>
                }
                else
                {
                    <button class="modal-create" @onclick="ConfirmCreateAhaMoveOrder"
                            disabled="@creatingAhaMove" style="background: #ea5800; border-color: #ea5800;">
                        @(creatingAhaMove ? "Đang đặt..." : "Xác nhận đặt xe")
                    </button>
                }
            </div>
        </div>
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "c")]
    public int? QueryConversationId { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (QueryConversationId.HasValue && QueryConversationId.Value != selectedId)
        {
            selectedId = QueryConversationId.Value;
            await ReloadAsync();
        }
    }

