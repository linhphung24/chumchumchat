            selectedId = QueryConversationId.Value;
            await ReloadAsync();
        }
    }

    private static readonly string[] TagPresets = ["Đang tư vấn", "Chờ phản hồi", "Đã chốt đơn", "Hủy"];

    private List<Conversation> conversations = [];
    private List<Message> messages = [];
    private Conversation? selected;
    private int? selectedId;
    private bool mobileShowCustomerPanel = false;
    private bool pushSubscribed;
    private string? pushError;
    private ChannelType? filter;
    private string draft = "";
    private bool sending;
    private bool creatingCard;
    private string? trelloNote;
    private string? trelloCardUrl;
    private bool trelloNoteIsError;
    private bool showTrelloModal;
    private bool showAhaMoveModal;
    private Order? selectedOrderForAhaMove;
    private string ahaMoveReceiverName = "";
    private string ahaMoveReceiverMobile = "";
    private string ahaMoveReceiverAddress = "";
    private List<AddressSuggestion> addressSuggestions = new();
    private double? suggestedLat;
    private double? suggestedLng;
    private System.Threading.CancellationTokenSource? addressCts;
    
    // Gợi ý khách hàng từ đơn cũ
    private List<InboxService.CustomerInfo> customerSuggestions = new();
    private string activeSuggestionField = "";
    
    // Các biến cấu hình Tỉnh/Quận/Phường
    private bool useStructuredAddress = false;
    private List<Province> provinces = [];
    private List<District> districts = [];
    private List<Ward> wards = [];
    private int selectedProvinceCode;
    private int selectedDistrictCode;
    private int selectedWardCode;
    private string streetAddress = "";
    private bool creatingAhaMove;
    private string? ahaMoveModalError;
    private long? ahaMoveEstimatedFee;
    private bool estimatingAhaMove;
    
    // Thêm các biến cấu hình Lalamove
    private string selectedCarrier = "ahamove"; 
    private string lalamoveQuotationId = "";
    private string lalamoveSenderStopId = "";
    private string lalamoveRecipientStopId = "";
    private string trelloName = "";
    private string trelloDesc = "";
    private string? trelloModalError;
    private List<Order> orders = [];

    private List<Staff> staff = [];
    private Dictionary<int, string> staffNames = [];
    private List<QuickReply> quickReplies = [];
    private bool mineOnly;
    private int currentStaffId;
    private string currentStaffName = "";
    private bool isAdmin;
    private bool aiLoading;
    private readonly CancellationTokenSource pollCts = new();
    private string? aiError;

    // ===== Form tạo đơn =====
    private string activeTab = "info";
    private string orderPhone = "";
    private string orderAddress = "";
    private string orderPayment = "COD";
    private long orderShipping;
    private long orderDiscount;
    private string orderNote = "";
    private List<OrderFormItem> orderItems = [];
    private string productSearch = "";
    private List<Product> allProducts = [];
    private bool creatingOrder;
    private bool estimatingOrderFormShipping = false;
    private string? orderFormShippingError;
    private string? orderFormError;
    private string? orderFormSuccess;
    private bool showAddProductForm;
    private string newProductName = "";
    private long newProductPrice;

    private long ItemsTotal => orderItems.Sum(i => (long)i.Quantity * i.UnitPrice);
    private long OrderGrandTotal => ItemsTotal + orderShipping - orderDiscount;
    private IEnumerable<Product> FilteredProducts =>
        allProducts.Where(p => p.Name.Contains(productSearch, StringComparison.OrdinalIgnoreCase)
            || p.Sku.Contains(productSearch, StringComparison.OrdinalIgnoreCase)).Take(10);

    private class OrderFormItem
    {
        public string Name { get; set; } = "";
        public int Quantity { get; set; } = 1;
        public long UnitPrice { get; set; }
    }

    private int lastRenderedMessageId = -1;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var status = await JS.InvokeAsync<string>("getPushSubscriptionStatus");
                pushSubscribed = status == "Subscribed";
                StateHasChanged();
            }
            catch { /* SW chưa sẵn sàng hoặc không chạy trong trình duyệt */ }
        }

        if (messages.Count > 0)
        {
            var currentLastId = messages[^1].Id;
            if (currentLastId != lastRenderedMessageId)
            {
                lastRenderedMessageId = currentLastId;
                await JS.InvokeVoidAsync("scrollToBottom", "messages");
            }
        }
    }

    private async Task TogglePushSubscription()
    {
        pushError = null;
        if (pushSubscribed)
        {
            try
            {
                var endpoint = await JS.InvokeAsync<string>("unsubscribeUserFromPush");
                if (!string.IsNullOrEmpty(endpoint))
                {
                    await PushSvc.UnsubscribeAsync(endpoint);
                }
                pushSubscribed = false;
                StateHasChanged();
            }
            catch (Exception ex)
            {
                pushError = "Lỗi gỡ thông báo: " + ex.Message;
            }
        }
        else
        {
            try
            {
                var permission = await JS.InvokeAsync<string>("requestNotificationPermission");
                if (permission != "granted")
                {
                    pushError = "Trình duyệt đã từ chối quyền gửi thông báo.";
                    return;
                }

                var vapidKeys = Store.Vapid;
                if (string.IsNullOrEmpty(vapidKeys.PublicKey))
                {
                    pushError = "Khóa VAPID chưa được tạo trên máy chủ.";
                    return;
                }

                var subJson = await JS.InvokeAsync<string>("subscribeUserToPush", vapidKeys.PublicKey);
                using var doc = JsonDocument.Parse(subJson);
                var root = doc.RootElement;
                var endpoint = root.GetProperty("endpoint").GetString() ?? "";
                var p256dh = root.GetProperty("p256dh").GetString() ?? "";
                var auth = root.GetProperty("auth").GetString() ?? "";

                await PushSvc.SubscribeAsync(currentStaffId, endpoint, p256dh, auth);
                pushSubscribed = true;
                StateHasChanged();
            }
            catch (Exception ex)
            {
                pushError = "Lỗi đăng ký thông báo: " + ex.Message;
            }
        }
    }

    private async Task ScrollToBottomAsync()
    {
        await Task.Delay(50);
        await JS.InvokeVoidAsync("scrollToBottom", "messages");
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthState.GetAuthenticationStateAsync();
        var user = authState.User;
        int.TryParse(user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out currentStaffId);
        currentStaffName = user.Identity?.Name ?? "Nhân viên";
        isAdmin = user.IsInRole("Admin");

        staff = (await StaffSvc.GetAllAsync()).Where(s => s.IsActive).ToList();
        staffNames = staff.ToDictionary(s => s.Id, s => s.DisplayName);
        quickReplies = await QuickReplies.GetAllAsync();
        allProducts = await InboxSvc.GetAllProductsAsync();

        Events.Changed += OnInboxChanged;
        await ReloadAsync();

        // Tự động làm mới định kỳ (dự phòng khi tín hiệu realtime không tới) — cứ 6 giây tải lại
        _ = PollLoopAsync(pollCts.Token);
    }

    private async Task PollLoopAsync(CancellationToken ct)
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(6));
            while (await timer.WaitForNextTickAsync(ct))
            {
                await InvokeAsync(async () =>
                {
                    await ReloadAsync();
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException) { /* rời trang */ }
    }

    private void OnInboxChanged()
    {
        // Sự kiện đến từ thread webhook → phải nhảy về sync context của circuit
        _ = InvokeAsync(async () =>
        {
            await ReloadAsync();
            StateHasChanged();
        });
    }

    private async Task ReloadAsync()
    {
        conversations = await InboxSvc.GetConversationsAsync(filter, mineOnly ? currentStaffId : null);
        var oldSelectedId = selected?.Id;
        selected = conversations.FirstOrDefault(c => c.Id == selectedId);
        if (selected is not null)
        {
            // Hội thoại đang mở trước mắt nhân viên → tin mới coi như đã đọc
            if (selected.UnreadCount > 0)
            {
                await InboxSvc.MarkReadAsync(selected.Id);
                selected.UnreadCount = 0;
            }
            messages = await InboxSvc.GetMessagesAsync(selected.Id);
            orders = await InboxSvc.GetOrdersAsync(selected.Id);

            if (oldSelectedId != selected.Id)
            {
                custName = selected.CustomerName;
                custPhone = selected.CustomerPhone;
                custAddress = selected.CustomerAddress;
                custSaveMessage = "";

                // Điền sẵn vào form tạo đơn nếu trống
                orderPhone = selected.CustomerPhone;
                orderAddress = selected.CustomerAddress;
            }
        }
    }

