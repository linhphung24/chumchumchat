    private async Task EstimateAhaMoveFee()
    {
        if (selectedOrderForAhaMove is null || estimatingAhaMove) return;

        estimatingAhaMove = true;
        ahaMoveModalError = null;
        ahaMoveEstimatedFee = null;
        lalamoveQuotationId = "";
        try
        {
            if (string.IsNullOrWhiteSpace(ahaMoveReceiverName) || string.IsNullOrWhiteSpace(ahaMoveReceiverMobile) || string.IsNullOrWhiteSpace(ahaMoveReceiverAddress))
                throw new Exception("Vui lòng nhập đầy đủ Tên, SĐT và Địa chỉ người nhận.");

            double lat = 0;
            double lng = 0;

            if (suggestedLat.HasValue && suggestedLng.HasValue)
            {
                lat = suggestedLat.Value;
                lng = suggestedLng.Value;
            }
            else
            {
                var coords = await LalamoveSvc.GeocodeAddressAsync(ahaMoveReceiverAddress);
                lat = coords.Lat;
                lng = coords.Lng;
            }

            var res = await LalamoveSvc.EstimateOrderFeeAsync(
                Store.Lalamove.SenderLat, Store.Lalamove.SenderLng, Store.Lalamove.SenderAddress,
                lat, lng, ahaMoveReceiverAddress,
                Store.Lalamove
            );
            ahaMoveEstimatedFee = res.TotalFee;
            lalamoveQuotationId = res.QuotationId;
            lalamoveSenderStopId = res.SenderStopId;
            lalamoveRecipientStopId = res.RecipientStopId;
        }
        catch (Exception ex)
        {
            ahaMoveModalError = ex.Message;
        }
        finally
        {
            estimatingAhaMove = false;
        }
    }

