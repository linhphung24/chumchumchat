    private static bool IsImageUrl(string url)
    {
        var u = url.ToLowerInvariant();
        foreach (var ext in new[] { ".pdf", ".doc", ".docx", ".xls", ".xlsx", ".ppt", ".pptx", ".zip", ".rar", ".txt", ".csv" })
            if (u.EndsWith(ext))
                return false;
        return true;
    }

