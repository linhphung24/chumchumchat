    private async Task ConfirmCreateAhaMoveOrder()
    {
        if (selectedOrderForAhaMove is null || creatingAhaMove || selected is null) return;

        creatingAhaMove = true;
        ahaMoveModalError = null;
        try
        {
            if (string.IsNullOrWhiteSpace(ahaMoveReceiverName) || string.IsNullOrWhiteSpace(ahaMoveReceiverMobile) || string.IsNullOrWhiteSpace(ahaMoveReceiverAddress))
                throw new Exception("Vui lòng nhập đầy đủ Tên, SĐT và Địa chỉ người nhận.");

            if (string.IsNullOrEmpty(lalamoveQuotationId))
            {
                double lat = 0;
                double lng = 0;

                if (suggestedLat.HasValue && suggestedLng.HasValue)
                {
                    lat = suggestedLat.Value;
                    lng = suggestedLng.Value;
                }
                else
                {
                    var coords = await LalamoveSvc.GeocodeAddressAsync(ahaMoveReceiverAddress);
                    lat = coords.Lat;
                    lng = coords.Lng;
                }

                var est = await LalamoveSvc.EstimateOrderFeeAsync(
                    Store.Lalamove.SenderLat, Store.Lalamove.SenderLng, Store.Lalamove.SenderAddress,
