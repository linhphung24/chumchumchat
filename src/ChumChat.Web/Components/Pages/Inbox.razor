    {
        if (selectedOrderForAhaMove is null || creatingAhaMove || selected is null) return;

        creatingAhaMove = true;
        ahaMoveModalError = null;
        try
        {
            if (string.IsNullOrWhiteSpace(ahaMoveReceiverName) || string.IsNullOrWhiteSpace(ahaMoveReceiverMobile) || string.IsNullOrWhiteSpace(ahaMoveReceiverAddress))
                throw new Exception("Vui lòng nhập đầy đủ Tên, SĐT và Địa chỉ người nhận.");

            var req = await BuildAhaMoveOrderRequestAsync();

            var res = await AhaMoveSvc.CreateOrderAsync(req, Store.AhaMove.Token);
            
