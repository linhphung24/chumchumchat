    // Nhân viên chọn ảnh → lưu vào wwwroot/uploads → gửi ngay cho khách
    private async Task OnImageSelected(InputFileChangeEventArgs e)
    {
        if (selected is null || sending)
            return;

        sending = true;
        try
        {
            var file = e.File;
            var ext = Path.GetExtension(file.Name);
            if (string.IsNullOrEmpty(ext) || ext.Length > 5)
                ext = ".jpg";
            var fileName = $"{Guid.NewGuid():N}{ext}";
            var uploadsDir = Path.Combine(HostEnv.WebRootPath, "uploads");
            Directory.CreateDirectory(uploadsDir);

            await using (var target = File.Create(Path.Combine(uploadsDir, fileName)))
            await using (var source = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024))
            {
                await source.CopyToAsync(target);
            }

            var bytes = await File.ReadAllBytesAsync(Path.Combine(uploadsDir, fileName));
            var localUrl = $"/uploads/{fileName}";
            var publicUrl = Nav.BaseUri.TrimEnd('/') + localUrl;

            await InboxSvc.SendReplyAsync(selected.Id, "", new ReplyImage(localUrl, publicUrl, bytes, fileName));
        }
        finally
        {
            sending = false;
        }
        await ReloadAsync();
    }

