    private async Task SubmitOrderAsync()
    {
        if (selected is null || creatingOrder || orderItems.Count == 0) return;
        creatingOrder = true;
        orderFormError = null;
        orderFormSuccess = null;
        try
        {
            // Xây dựng nội dung thẻ Trello từ thông tin đơn hàng
            string? trelloUrl = null;
            var cardName = $"🧾 {selected.CustomerName} — đơn qua {ChannelLabel(selected.Channel)}";

            if (Trello.IsConfigured)
            {
                var desc = new System.Text.StringBuilder();
                desc.AppendLine($"**Khách hàng:** {selected.CustomerName}");
                if (!string.IsNullOrWhiteSpace(orderPhone))
                    desc.AppendLine($"**SĐT:** {orderPhone}");
                if (!string.IsNullOrWhiteSpace(orderAddress))
                    desc.AppendLine($"**Địa chỉ:** {orderAddress}");
                desc.AppendLine($"**Kênh:** {ChannelLabel(selected.Channel)}");
                desc.AppendLine($"**Thời điểm tạo đơn:** {DateTime.Now:HH:mm dd/MM/yyyy}");
                desc.AppendLine();
                desc.AppendLine("---");
                desc.AppendLine("**📦 Sản phẩm:**");
                desc.AppendLine("| Tên SP | SL | Đơn giá | Thành tiền |");
                desc.AppendLine("|---|---|---|---|");
                foreach (var item in orderItems)
                {
                    var lineTotal = (long)item.Quantity * item.UnitPrice;
                    desc.AppendLine($"| {item.Name} | {item.Quantity} | {item.UnitPrice:N0}đ | {lineTotal:N0}đ |");
                }
                desc.AppendLine();
                desc.AppendLine("---");
                desc.AppendLine("**💳 Thanh toán:**");
                desc.AppendLine($"- Tổng giá trị sản phẩm: **{ItemsTotal:N0}đ**");
                if (orderShipping > 0)
                    desc.AppendLine($"- Phí vận chuyển: {orderShipping:N0}đ");
                if (orderDiscount > 0)
                    desc.AppendLine($"- Giảm giá: -{orderDiscount:N0}đ");
                desc.AppendLine($"- **Tổng thanh toán: {OrderGrandTotal:N0}đ**");
                desc.AppendLine($"- Hình thức: {orderPayment}");
                if (!string.IsNullOrWhiteSpace(orderNote))
                {
                    desc.AppendLine();
                    desc.AppendLine($"**📝 Ghi chú:** {orderNote}");
                }

                trelloUrl = await Trello.CreateCardAsync(cardName, desc.ToString());
            }

            var order = new Order
            {
                ConversationId = selected.Id,
                Title = cardName,
                CustomerPhone = orderPhone,
                CustomerAddress = orderAddress,
                PaymentMethod = orderPayment,
                ShippingFee = orderShipping,
                Discount = orderDiscount,
                Note = orderNote,
                TrelloCardUrl = trelloUrl,
                Items = orderItems.Select(i => new OrderItem
                {
                    ProductName = i.Name,
                    Quantity = i.Quantity,
                    UnitPrice = i.UnitPrice
                }).ToList()
            };
            await InboxSvc.CreateOrderAsync(order);
            ResetOrderForm();
            orderFormSuccess = trelloUrl is not null
                ? "Đã tạo đơn hàng + thẻ Trello thành công!"
                : "Đã tạo đơn hàng thành công!";
            await InboxSvc.SetTagAsync(selected.Id, "Đã chốt đơn");
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            orderFormError = ex.Message;
        }
        finally
        {
            creatingOrder = false;
        }
    }

    public void Dispose()
    {
