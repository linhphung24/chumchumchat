@code {
    private bool isAdmin;
    private bool isLoading = true;
    private List<Order> orders = [];
    private HashSet<int> selectedOrderIds = [];

    // Filter states
    private string searchKeyword = "";
    private string selectedProduct = "";
    private string selectedArea = "";
    private string selectedGroupFilter = "all"; // all, grouped, single
    private string selectedStatusFilter = "active"; // active, completed, cancelled, all

    private async Task ChangeOrderStatus(int orderId, string status)
    {
        await InboxSvc.UpdateOrderStatusAsync(orderId, status);
        await LoadOrdersAsync();
    }

    // Batch grouping modal
    private bool showGroupModal = false;
    private string modalBatchCode = "";

    private bool showLalamoveGroupModal = false;
    private bool lalamoveGroupEstimating = false;
    private bool lalamoveGroupBooking = false;
    private long lalamoveGroupTotalFee = 0;
    private string lalamoveGroupQuotationId = "";
    private string lalamoveGroupSenderStopId = "";
    private string lalamoveGroupError = "";
    private List<LalamoveMultiStopRecipient> lalamoveRecipients = new();

    private void LalamoveSingleOrder(Order o)
    {
        selectedOrderIds.Clear();
        selectedOrderIds.Add(o.Id);
        _ = OpenLalamoveGroupModal();
    }

    private async Task OpenLalamoveGroupModal()
    {
        if (selectedOrderIds.Count == 0) return;
        showLalamoveGroupModal = true;
        lalamoveGroupEstimating = true;
        lalamoveGroupError = "";
        lalamoveGroupTotalFee = 0;
        lalamoveGroupQuotationId = "";
        lalamoveGroupSenderStopId = "";
        lalamoveRecipients.Clear();

        StateHasChanged();

        try
        {
            var lalaOpts = Store.Lalamove;
            if (string.IsNullOrEmpty(lalaOpts.ApiKey))
            {
                lalamoveGroupError = "Chưa cấu hình Lalamove API Key. Vui lòng vào Cấu Hình để thiết lập!";
                lalamoveGroupEstimating = false;
                return;
            }

            var targetOrders = orders.Where(x => selectedOrderIds.Contains(x.Id)).ToList();
            foreach (var o in targetOrders)
            {
                var addr = o.CustomerAddress;
                if (string.IsNullOrWhiteSpace(addr)) continue;

                var coords = await LalamoveSvc.GeocodeAddressAsync(addr);
                if (coords.Lat == 0 && coords.Lng == 0)
                {
                    coords = (lalaOpts.SenderLat != 0 ? lalaOpts.SenderLat : 21.028511, lalaOpts.SenderLng != 0 ? lalaOpts.SenderLng : 105.854444);
                }

                lalamoveRecipients.Add(new LalamoveMultiStopRecipient
                {
                    OrderId = o.Id,
                    Name = string.IsNullOrWhiteSpace(o.Title) ? "Khách hàng" : o.Title,
                    Phone = string.IsNullOrWhiteSpace(o.CustomerPhone) ? "0900000000" : o.CustomerPhone,
                    Address = addr,
                    Lat = coords.Lat,
                    Lng = coords.Lng
                });
            }

            if (lalamoveRecipients.Count == 0)
            {
                lalamoveGroupError = "Các đơn hàng được chọn chưa có địa chỉ giao hàng hợp lệ!";
                lalamoveGroupEstimating = false;
                return;
            }

            var res = await LalamoveSvc.EstimateMultiStopFeeAsync(
                lalaOpts.SenderLat, lalaOpts.SenderLng, lalaOpts.SenderAddress,
                lalamoveRecipients, lalaOpts);

            lalamoveGroupQuotationId = res.QuotationId;
            lalamoveGroupTotalFee = res.TotalFee;
            lalamoveGroupSenderStopId = res.SenderStopId;
            lalamoveRecipients = res.Recipients;
        }
        catch (Exception ex)
        {
            lalamoveGroupError = ex.Message;
        }
        finally
        {
            lalamoveGroupEstimating = false;
            StateHasChanged();
        }
    }

    private void CloseLalamoveGroupModal()
    {
        showLalamoveGroupModal = false;
    }

    private async Task ConfirmLalamoveGroupBooking()
    {
        if (lalamoveRecipients.Count == 0 || lalamoveGroupBooking) return;
        lalamoveGroupBooking = true;
        lalamoveGroupError = "";
        StateHasChanged();

        try
        {
            var lalaOpts = Store.Lalamove;
            var batchCode = $"CH-{DateTime.Now:yyyyMMdd-HHmm}";

            var res = await LalamoveSvc.CreateMultiStopOrderAsync(
                lalamoveGroupQuotationId,
                lalamoveGroupSenderStopId,
                lalaOpts.SenderName, lalaOpts.SenderMobile,
                lalamoveRecipients, lalaOpts);

            var orderIdList = selectedOrderIds.ToList();
            await InboxSvc.BatchGroupOrdersAsync(orderIdList, batchCode);
            await InboxSvc.BatchUpdateLalamoveOrderInfoAsync(orderIdList, res.OrderId, res.ShareLink);

            showLalamoveGroupModal = false;
            selectedOrderIds.Clear();
            await LoadOrdersAsync();
        }
        catch (Exception ex)
        {
            lalamoveGroupError = ex.Message;
        }
        finally
        {
            lalamoveGroupBooking = false;
            StateHasChanged();
        }
    }

    // Computed metrics
    private long totalRevenue => orders.Sum(o => o.Amount);
    private int groupedCount => orders.Count(o => o.IsGrouped);
    private bool isAllSelected => orders.Count > 0 && selectedOrderIds.Count == orders.Count;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthState.GetAuthenticationStateAsync();
        isAdmin = authState.User.IsInRole("Admin") || authState.User.IsInRole("Manager");
        await LoadOrdersAsync();
    }

    private async Task LoadOrdersAsync()
    {
        isLoading = true;
        currentPage = 1;
        bool? isGroupedFilter = selectedGroupFilter switch
        {
            "grouped" => true,
            "single" => false,
            _ => null
        };

        orders = await InboxSvc.GetAllOrdersSummaryAsync(
            search: searchKeyword,
            productName: selectedProduct,
            area: selectedArea,
            isGrouped: isGroupedFilter,
            statusFilter: selectedStatusFilter
        );
        isLoading = false;
    }

    private async Task ApplyFilters()
    {
        await LoadOrdersAsync();
    }

    private async Task ResetFilters()
    {
        searchKeyword = "";
        selectedProduct = "";
        selectedArea = "";
        selectedGroupFilter = "all";
        selectedStatusFilter = "active";
        await LoadOrdersAsync();
    }

    // Pagination state & helpers
    private int currentPage = 1;
    private int pageSize = 15;
    private int totalPages => Math.Max(1, (int)Math.Ceiling((double)orders.Count / pageSize));
    private IEnumerable<Order> pagedOrders => orders.Skip((currentPage - 1) * pageSize).Take(pageSize);

    private void OnPageSizeChanged() => currentPage = 1;
    private void GoToFirstPage() => currentPage = 1;
    private void GoToPrevPage() => currentPage = Math.Max(1, currentPage - 1);
    private void GoToNextPage() => currentPage = Math.Min(totalPages, currentPage + 1);
    private void GoToLastPage() => currentPage = totalPages;

    // iPOS Print Thermal Receipt Modal State
    private bool showPrintIposModal = false;
    private string printBatchCode = "";
    private List<Order> printSelectedOrders = [];
    private List<AggregatedItem> printAggregatedItems = [];
    private long printTotalAmount = 0;

    public class AggregatedItem
    {
        public string ProductName { get; set; } = "";
        public int Quantity { get; set; }
        public long UnitPrice { get; set; }
        public long TotalPrice => Quantity * UnitPrice;
    }

    private void OpenPrintIposModal()
    {
        var targetOrders = selectedOrderIds.Count > 0
            ? orders.Where(o => selectedOrderIds.Contains(o.Id)).ToList()
            : pagedOrders.ToList();

        if (targetOrders.Count == 0)
        {
            JS.InvokeVoidAsync("alert", "Không có đơn hàng nào để in Hóa đơn iPOS!");
            return;
        }

        printSelectedOrders = targetOrders;
        printBatchCode = targetOrders.FirstOrDefault(o => !string.IsNullOrEmpty(o.GroupBatchCode))?.GroupBatchCode ?? $"CH-{DateTime.Now:yyyyMMdd-HHmm}";
        
        var itemMap = new Dictionary<string, AggregatedItem>();
        long total = 0;
        foreach (var o in targetOrders)
        {
            total += o.Amount;
            if (o.Items != null)
            {
                foreach (var item in o.Items)
                {
                    if (itemMap.ContainsKey(item.ProductName))
                    {
                        itemMap[item.ProductName].Quantity += item.Quantity;
                    }
                    else
                    {
                        var uPrice = item.UnitPrice;
                        itemMap[item.ProductName] = new AggregatedItem
                        {
                            ProductName = item.ProductName,
                            Quantity = item.Quantity,
                            UnitPrice = uPrice
                        };
                    }
                }
            }
        }
        printAggregatedItems = itemMap.Values.ToList();
        printTotalAmount = total;
        showPrintIposModal = true;
    }

