                                <span style="color: #64748b; font-size: 12px;">Số đơn/trang:</span>
                                <select @bind="pageSize" @bind:after="OnPageSizeChanged" style="padding: 4px 8px; border-radius: 6px; border: 1px solid #cbd5e1; font-size: 12px; outline: none; background: #fff;">
                                    <option value="10">10</option>
                                    <option value="15">15</option>
                                    <option value="25">25</option>
                                    <option value="50">50</option>
                                    <option value="100">100</option>
                                </select>
                            </div>

                            <div style="display: flex; align-items: center; gap: 4px;">
                                <button @onclick="GoToFirstPage" disabled="@(currentPage == 1)" style="padding: 5px 10px; border-radius: 6px; background: #ffffff; border: 1px solid #cbd5e1; cursor: pointer; font-size: 12px; font-weight: 600; color: #334155; opacity: @(currentPage == 1 ? "0.5" : "1");">
                                    ⏮️
                                </button>
                                <button @onclick="GoToPrevPage" disabled="@(currentPage == 1)" style="padding: 5px 10px; border-radius: 6px; background: #ffffff; border: 1px solid #cbd5e1; cursor: pointer; font-size: 12px; font-weight: 600; color: #334155; opacity: @(currentPage == 1 ? "0.5" : "1");">
                                    ◀️ Trước
                                </button>

                                <span style="font-weight: 700; color: #1e293b; padding: 0 8px;">Trang @currentPage / @totalPages</span>

                                <button @onclick="GoToNextPage" disabled="@(currentPage >= totalPages)" style="padding: 5px 10px; border-radius: 6px; background: #ffffff; border: 1px solid #cbd5e1; cursor: pointer; font-size: 12px; font-weight: 600; color: #334155; opacity: @(currentPage >= totalPages ? "0.5" : "1");">
                                    Sau ▶️
                                </button>
                                <button @onclick="GoToLastPage" disabled="@(currentPage >= totalPages)" style="padding: 5px 10px; border-radius: 6px; background: #ffffff; border: 1px solid #cbd5e1; cursor: pointer; font-size: 12px; font-weight: 600; color: #334155; opacity: @(currentPage >= totalPages ? "0.5" : "1");">
                                    ⏭️
                                </button>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>

<!-- MODAL POPUP GHÉP CHUYẾN ĐƠN HÀNG LALAMOVE -->
@if (showLalamoveGroupModal)
