    private void ToggleSelectOrder(int orderId)
    {
        if (selectedOrderIds.Contains(orderId))
            selectedOrderIds.Remove(orderId);
        else
            selectedOrderIds.Add(orderId);
    }

    private void ToggleSelectAll(ChangeEventArgs e)
    {
        if (e.Value is bool checkedVal && checkedVal)
        {
            selectedOrderIds = orders.Select(o => o.Id).ToHashSet();
        }
        else
        {
            selectedOrderIds.Clear();
        }
    }

    private void GroupSingleOrder(Order o)
    {
        selectedOrderIds.Clear();
        selectedOrderIds.Add(o.Id);
        OpenGroupModal();
    }

    private void OpenGroupModal()
    {
        if (selectedOrderIds.Count == 0) return;
        modalBatchCode = $"CH-{DateTime.Now:yyyyMMdd-HHmm}";
        showGroupModal = true;
    }

    private async Task ConfirmGroupBatch()
    {
        if (selectedOrderIds.Count == 0) return;
        await InboxSvc.BatchGroupOrdersAsync(selectedOrderIds.ToList(), modalBatchCode);
        showGroupModal = false;
        selectedOrderIds.Clear();
        await LoadOrdersAsync();
    }

    private async Task UngroupSelected()
    {
        if (selectedOrderIds.Count == 0) return;
        await InboxSvc.BatchUngroupOrdersAsync(selectedOrderIds.ToList());
        selectedOrderIds.Clear();
        await LoadOrdersAsync();
    }

    private (string Bg, string Color, string Border) GetTagBadgeStyle(string tag)
    {
        var t = tag.ToLowerInvariant();
        if (t.Contains("chốt") && t.Contains("nhanh"))
            return ("#f0fdf4", "#16a34a", "#bbf7d0"); // Green
        if (t.Contains("tư vấn") && t.Contains("kỹ"))
            return ("#fffbeb", "#d97706", "#fef3c7"); // Amber
        if (t.Contains("sỉ") || t.Contains("lớn"))
            return ("#faf5ff", "#9333ea", "#e9d5ff"); // Purple
        if (t.Contains("ck") || t.Contains("chuyển khoản"))
            return ("#eff6ff", "#2563eb", "#bfdbfe"); // Blue
        if (t.Contains("cod") || t.Contains("tiền mặt"))
            return ("#fff1f2", "#e11d48", "#fecdd3"); // Rose
        if (t.Contains("thân thiết"))
            return ("#fefce8", "#ca8a04", "#fef08a"); // Gold
        return ("#f1f5f9", "#475569", "#cbd5e1"); // Slate
    }

    private string ExtractArea(string address)
    {
        if (string.IsNullOrWhiteSpace(address)) return "";
        var addr = address.ToLower();
        if (addr.Contains("thanh xuân")) return "Thanh Xuân";
        if (addr.Contains("cầu giấy")) return "Cầu Giấy";
        if (addr.Contains("đống đa")) return "Đống Đa";
        if (addr.Contains("hai bà trưng")) return "Hai Bà Trưng";
        if (addr.Contains("hoàn kiếm")) return "Hoàn Kiếm";
        if (addr.Contains("ba đình")) return "Ba Đình";
        if (addr.Contains("tây hồ")) return "Tây Hồ";
        if (addr.Contains("hoàng mai")) return "Hoàng Mai";
        if (addr.Contains("hà đông")) return "Hà Đông";
        if (addr.Contains("thanh trì") || addr.Contains("ngũ hiệp") || addr.Contains("ngọc hồi")) return "Thanh Trì";
        if (addr.Contains("nam từ liêm")) return "Nam Từ Liêm";
        if (addr.Contains("bắc từ liêm")) return "Bắc Từ Liêm";
        if (addr.Contains("long biên")) return "Long Biên";
        return "";
    }
