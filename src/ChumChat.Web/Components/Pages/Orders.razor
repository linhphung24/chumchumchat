                                        <div style="display: flex; align-items: center; justify-content: flex-end; gap: 6px; flex-wrap: wrap;">
                                             @if (o.AhamoveStatus == "COMPLETED" || o.AhamoveStatus == "COMPLETED_BY_DRIVER")
                                             {
                                                 <span style="font-size: 11px; background: #dcfce7; color: #166534; font-weight: 700; padding: 3px 8px; border-radius: 4px;">✅ Hoàn thành</span>
                                                 <button @onclick='() => ChangeOrderStatus(o.Id, "")' style="padding: 5px 8px; border-radius: 6px; background: #f1f5f9; color: #475569; font-weight: 700; font-size: 11px; border: 1px solid #cbd5e1; cursor: pointer;" title="Khôi phục trạng thái Đang xử lý">
                                                     🔄 Khôi phục
                                                 </button>
                                             }
                                             else if (o.AhamoveStatus == "CANCELED" || o.AhamoveStatus == "CANCELLED" || o.AhamoveStatus == "EXPIRED")
                                             {
                                                 <span style="font-size: 11px; background: #fee2e2; color: #991b1b; font-weight: 700; padding: 3px 8px; border-radius: 4px;">❌ Đã hủy</span>
                                                 <button @onclick='() => ChangeOrderStatus(o.Id, "")' style="padding: 5px 8px; border-radius: 6px; background: #f1f5f9; color: #475569; font-weight: 700; font-size: 11px; border: 1px solid #cbd5e1; cursor: pointer;" title="Khôi phục trạng thái Đang xử lý">
                                                     🔄 Khôi phục
                                                 </button>
                                             }
                                             else
                                             {
                                                 <button @onclick='() => ChangeOrderStatus(o.Id, "COMPLETED")' style="padding: 5px 8px; border-radius: 6px; background: #f0fdf4; color: #16a34a; font-weight: 700; font-size: 11px; border: 1px solid #bbf7d0; cursor: pointer;" title="Đánh dấu Hoàn thành">
                                                     ✔ Hoàn thành
                                                 </button>
                                                 <button @onclick='() => ChangeOrderStatus(o.Id, "CANCELED")' style="padding: 5px 8px; border-radius: 6px; background: #fef2f2; color: #dc2626; font-weight: 700; font-size: 11px; border: 1px solid #fecaca; cursor: pointer;" title="Hủy đơn này">
                                                     ❌ Hủy
                                                 </button>
                                             }

                                            <button @onclick="() => LalamoveSingleOrder(o)" style="padding: 5px 10px; border-radius: 6px; background: #fff1f2; color: #e11d48; font-weight: 700; font-size: 12px; border: 1px solid #fecdd3; cursor: pointer;" title="Đặt Lalamove cho đơn này">
                                                📦 Lalamove
                                            </button>
                                            <button @onclick="() => GroupSingleOrder(o)" style="padding: 5px 10px; border-radius: 6px; background: #faf5ff; color: #9333ea; font-weight: 700; font-size: 12px; border: 1px solid #d8b4fe; cursor: pointer;" title="Tích đặt đơn ghép cho đơn này">
                                                🔗 Ghép đơn
                                            </button>
                                            <a href="/?conv=@o.ConversationId" style="display: inline-block; padding: 5px 12px; border-radius: 6px; background: #eff6ff; color: #2563eb; font-weight: 600; text-decoration: none; font-size: 12px; border: 1px solid #bfdbfe;">
                                                💬 Chat khách
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- PAGINATION CONTROL BAR -->
                @if (orders.Count > 0)
                {
                    <div style="padding: 12px 16px; background: #f8fafc; border-top: 1px solid #e2e8f0; display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; font-size: 13px;">
                        <div style="color: #64748b; font-weight: 500;">
                            Hiển thị <strong>@(((currentPage - 1) * pageSize) + 1)</strong> - <strong>@(Math.Min(currentPage * pageSize, orders.Count))</strong> trong tổng số <strong>@orders.Count</strong> đơn hàng
                        </div>

                        <div style="display: flex; align-items: center; gap: 12px;">
