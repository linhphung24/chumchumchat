    private async Task TestConnection(ChannelType channel)
    {
        testing = true;
        StateHasChanged();
        try
        {
            var adapter = Adapters.First(a => a.Channel == channel);
            testResults[channel] = await adapter.TestConnectionAsync();
        }
        catch (Exception ex)
        {
            testResults[channel] = new ConnectionTestResult(false, ex.Message);
        }
        finally
        {
            testing = false;
        }
    }

    private async Task CheckZaloPersonalSidecar(bool silent = false)
    {
        if (!silent)
        {
            syncing = true;
            banner = null;
            StateHasChanged();
        }

        try
        {
            var client = HttpFactory.CreateClient();
            client.Timeout = TimeSpan.FromSeconds(4);
            var body = await client.GetStringAsync(zaloPersonal.SidecarUrl.TrimEnd('/') + "/health");
            using var doc = System.Text.Json.JsonDocument.Parse(body);
            var loggedIn = doc.RootElement.TryGetProperty("loggedIn", out var li) && li.GetBoolean();
            if (loggedIn)
            {
                isZaloConnected = true;
                zaloQr = null;
                banner = "✔ Kết nối thành công! Tài khoản Zalo Cá Nhân đang hoạt động.";
                bannerIsError = false;
            }
            else if (doc.RootElement.TryGetProperty("qr", out var qr) && qr.ValueKind == System.Text.Json.JsonValueKind.String)
            {
                isZaloConnected = false;
                zaloQr = qr.GetString();
                if (!silent)
                {
                    banner = "⚠ Chưa đăng nhập — mở Zalo trên điện thoại quét mã QR bên dưới";
                    bannerIsError = true;
                }
            }
            else
            {
                isZaloConnected = false;
                if (!silent)
                {
                    banner = "⚠ Sidecar đang chạy nhưng chưa có mã QR (đang khởi tạo) — chờ vài giây...";
                    bannerIsError = true;
                }
            }
        }
        catch (Exception ex)
        {
            isZaloConnected = false;
            if (!silent)
            {
                banner = $"✕ Không gọi được sidecar tại {zaloPersonal.SidecarUrl} ({ex.Message})";
                bannerIsError = true;
            }
        }
        finally
        {
            if (!silent) syncing = false;
        }
    }

    private async Task RestartZaloPersonalSidecar()
    {
        syncing = true;
        banner = "Đang khởi động lại sidecar để lấy mã QR mới...";
        bannerIsError = false;
        zaloQr = null;
        StateHasChanged();
        try
        {
            var client = HttpFactory.CreateClient();
            client.Timeout = TimeSpan.FromSeconds(5);
            var req = new HttpRequestMessage(HttpMethod.Post, zaloPersonal.SidecarUrl.TrimEnd('/') + "/restart");
            if (!string.IsNullOrEmpty(zaloPersonal.ApiKey))
                req.Headers.Add("x-api-key", zaloPersonal.ApiKey);
            await client.SendAsync(req);
        }
        catch { /* Bỏ qua lỗi vì có thể sidecar đã tắt ngay lập tức */ }
        
        // Chờ sidecar khởi động lại và tạo mã QR mới
        await Task.Delay(3000);
        await CheckZaloPersonalSidecar();
    }

    private async Task SyncHistory(ChannelType channel)
    {
        syncing = true;
        banner = null;
        StateHasChanged();
        try
        {
            var adapter = Adapters.First(a => a.Channel == channel);
            var history = await adapter.FetchHistoryAsync(maxConversations: 20);
            var (convs, msgs) = await Inbox.ImportHistoryAsync(channel, history);
            banner = $"✔ Đồng bộ xong: {convs} hội thoại, {msgs} tin nhắn mới được nhập";
            bannerIsError = false;
        }
        catch (Exception ex)
        {
            banner = "✕ Đồng bộ thất bại: " + ex.Message;
            bannerIsError = true;
        }
        finally
        {
            syncing = false;
        }
    }

    private void ShowSaved()
    {
        banner = "✔ Đã lưu cấu hình";
        bannerIsError = false;
    }

