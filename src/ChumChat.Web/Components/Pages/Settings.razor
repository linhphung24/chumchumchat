@code {
    private string activeTab = "channels";
    private bool showChannelModal = false;
    private string modalPlatform = "zalo";
    private bool isEditing = false;

    private ZaloOptions zalo = new();
    private MessengerOptions messenger = new();
    private ShopeeOptions shopee = new();
    private TikTokShopOptions tiktok = new();
    private InstagramOptions instagram = new();
    private ZaloPersonalOptions zaloPersonal = new();
    private MessengerPersonalOptions messengerPersonal = new();
    private ThreadsOptions threads = new();
    private GoogleLocationOptions googleLocation = new();
    private TrelloOptions trello = new();
    private LalamoveOptions lalamove = new();
    private bool isLalamoveLoading;
    private string? lalamoveError;

    private List<Staff> staffList = [];
    private string newStaffUsername = "", newStaffName = "", newStaffPassword = "";
    private bool newStaffAdmin;
    private string? staffError;

    private List<QuickReply> quickList = [];
    private string newQuickTitle = "", newQuickContent = "";

    private string? banner;
    private bool bannerIsError;
    private bool syncing;
    private bool testing;
    private string? zaloQr;
    private readonly Dictionary<ChannelType, ConnectionTestResult> testResults = [];
    private IReadOnlyList<WebhookLogEntry> webhookEntries = [];

    private void RefreshWebhookLog() => webhookEntries = WebhookLog.GetRecent();

    private void OpenAddModal()
    {
        isEditing = false;
        modalPlatform = "zalo";
        showChannelModal = true;
    }

    private void OpenConfigModal(string platform)
    {
        isEditing = true;
        modalPlatform = platform;
        showChannelModal = true;
    }

    private void CloseModal()
    {
        showChannelModal = false;
        zaloQr = null;
    }

    private ChannelType GetChannelType(string platform) => platform switch
    {
        "zalo" => ChannelType.Zalo,
        "messenger" => ChannelType.Messenger,
        "shopee" => ChannelType.Shopee,
        "tiktok" => ChannelType.TikTokShop,
        "instagram" => ChannelType.Instagram,
        "zalopersonal" => ChannelType.ZaloPersonal,
        "messengerpersonal" => ChannelType.MessengerPersonal,
        "threads" => ChannelType.Threads,
        "googlelocation" => ChannelType.GoogleLocation,
        _ => throw new ArgumentException("Unknown platform: " + platform)
    };

    private static string WebhookLabel(string status) => status switch
    {
        WebhookLogService.StatusSaved => "✔ Đã lưu tin",
        WebhookLogService.StatusDuplicate => "↩ Trùng (bỏ qua)",
        WebhookLogService.StatusSignatureFail => "✕ Sai chữ ký",
        WebhookLogService.StatusNoMessage => "— Không phải tin văn bản",
        WebhookLogService.StatusError => "✕ Lỗi xử lý",
        _ => status
    };

    private static string WebhookCss(string status) => status switch
    {
        WebhookLogService.StatusSaved => "ok",
        WebhookLogService.StatusDuplicate => "warn",
        WebhookLogService.StatusNoMessage => "warn",
        _ => "fail"
    };

    private static string Inbox_ChannelLabel(ChannelType c) => Components.Pages.Inbox.ChannelLabel(c);

    private string BaseUrl => Nav.BaseUri.TrimEnd('/');

    protected override async Task OnInitializedAsync()
    {
        zalo = Clone(Store.Zalo);
        messenger = Clone(Store.Messenger);
        shopee = Clone(Store.Shopee);
        tiktok = Clone(Store.TikTokShop);
        instagram = Clone(Store.Instagram);
        zaloPersonal = Clone(Store.ZaloPersonal);
        messengerPersonal = Clone(Store.MessengerPersonal);
        threads = Clone(Store.Threads);
        googleLocation = Clone(Store.GoogleLocation);
        trello = Clone(Store.Trello);
        lalamove = Clone(Store.Lalamove);

        staffList = await StaffSvc.GetAllAsync();
        quickList = await QuickReplies.GetAllAsync();
        RefreshWebhookLog();

        var query = System.Web.HttpUtility.ParseQueryString(new Uri(Nav.Uri).Query);
        if (query["connected"] is { } channel)
        {
            banner = $"✔ Đã kết nối {ChannelDisplay(channel)} thành công!";
        }
        else if (query["error"] is { } error)
        {
            banner = "✕ " + error;
            bannerIsError = true;
        }
    }

    private static string ChannelDisplay(string key) => key switch
    {
        "zalo" => "Zalo OA",
        "messenger" => "Facebook Messenger",
        "shopee" => "Shopee",
        "tiktok" => "TikTok Shop",
        "threads" => "Threads",
        "googlelocation" => "Google Location",
        _ => key
    };

    private static T Clone<T>(T source) =>
        JsonSerializer.Deserialize<T>(JsonSerializer.Serialize(source))!;

    private RenderFragment StatusBadge(string token, string accountName, DateTime? expiresAt) => __builder =>
    {
        @if (!string.IsNullOrEmpty(token))
        {
            <span class="status-badge connected">
                Đã kết nối@(string.IsNullOrEmpty(accountName) ? "" : $": {accountName}")
                @if (expiresAt is not null)
                {
                    <em> · token hết hạn @expiresAt.Value.ToLocalTime().ToString("HH:mm dd/MM")</em>
                }
            </span>
        }
        else
        {
            <span class="status-badge disconnected">Chưa kết nối</span>
        }
    };

