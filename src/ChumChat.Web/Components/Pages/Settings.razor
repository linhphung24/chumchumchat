    private void RefreshWebhookLog() => webhookEntries = WebhookLog.GetRecent();

    private void OpenAddModal()
    {
        isEditing = false;
        modalPlatform = "zalo";
        showChannelModal = true;
    }

    private bool isZaloConnected;
    private bool isPollingZaloQr;

    private void OpenConfigModal(string platform)
    {
        isEditing = true;
        modalPlatform = platform;
        showChannelModal = true;
        if (platform == "zalopersonal")
        {
            _ = CheckZaloPersonalSidecar();
            StartZaloQrPollingAsync();
        }
    }

    private void CloseModal()
    {
        showChannelModal = false;
        zaloQr = null;
        isPollingZaloQr = false;
    }

    private void StartZaloQrPollingAsync()
    {
        if (isPollingZaloQr) return;
        isPollingZaloQr = true;
        _ = Task.Run(async () =>
        {
            while (isPollingZaloQr && showChannelModal && modalPlatform == "zalopersonal")
            {
                await Task.Delay(2000);
                if (!isPollingZaloQr || !showChannelModal || modalPlatform != "zalopersonal") break;

                await InvokeAsync(async () =>
                {
                    await CheckZaloPersonalSidecar(silent: true);
                    StateHasChanged();
                });

                if (isZaloConnected)
                {
                    break;
                }
            }
            isPollingZaloQr = false;
        });
    }

    private ChannelType GetChannelType(string platform) => platform switch
    {
        "zalo" => ChannelType.Zalo,
        "messenger" => ChannelType.Messenger,
        "shopee" => ChannelType.Shopee,
        "tiktok" => ChannelType.TikTokShop,
        "instagram" => ChannelType.Instagram,
        "zalopersonal" => ChannelType.ZaloPersonal,
        "messengerpersonal" => ChannelType.MessengerPersonal,
        "threads" => ChannelType.Threads,
        "googlelocation" => ChannelType.GoogleLocation,
        _ => throw new ArgumentException("Unknown platform: " + platform)
    };

    private static string WebhookLabel(string status) => status switch
    {
        WebhookLogService.StatusSaved => "✔ Đã lưu tin",
        WebhookLogService.StatusDuplicate => "↩ Trùng (bỏ qua)",
        WebhookLogService.StatusSignatureFail => "✕ Sai chữ ký",
        WebhookLogService.StatusNoMessage => "— Không phải tin văn bản",
        WebhookLogService.StatusError => "✕ Lỗi xử lý",
        _ => status
    };

    private static string WebhookCss(string status) => status switch
    {
        WebhookLogService.StatusSaved => "ok",
        WebhookLogService.StatusDuplicate => "warn",
        WebhookLogService.StatusNoMessage => "warn",
        _ => "fail"
    };

    private static string Inbox_ChannelLabel(ChannelType c) => Components.Pages.Inbox.ChannelLabel(c);

    private string BaseUrl => Nav.BaseUri.TrimEnd('/');

    protected override async Task OnInitializedAsync()
    {
        zalo = Clone(Store.Zalo);
        messenger = Clone(Store.Messenger);
        shopee = Clone(Store.Shopee);
        tiktok = Clone(Store.TikTokShop);
        instagram = Clone(Store.Instagram);
        zaloPersonal = Clone(Store.ZaloPersonal);
