@page "/settings"
@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer
@using System.Text.Json
@using ChumChat.Web.Channels
@using ChumChat.Web.Data
@using ChumChat.Web.Services
@inject ChannelSettingsStore Store
@inject NavigationManager Nav
@inject InboxService Inbox
@inject IEnumerable<IChannelAdapter> Adapters
@inject IHttpClientFactory HttpFactory
@inject StaffService StaffSvc
@inject QuickReplyService QuickReplies
@inject WebhookLogService WebhookLog
@inject SidecarManagerService SidecarManager
@inject LalamoveService LalamoveSvc

<PageTitle>Cấu hình hệ thống — ChumChat</PageTitle>

<div class="settings dashboard-mode">
    <div class="settings-header">
        <h1>⚙ Cấu hình hệ thống</h1>
        <a href="/">← Về Hộp thư</a>
    </div>

    @if (banner is not null)
    {
        <div class="banner @(bannerIsError ? "banner-error" : "banner-ok")">@banner</div>
    }

    <div class="settings-tabs">
        <button class="tab-btn @(activeTab == "channels" ? "active" : "")" @onclick="@(() => activeTab = "channels")">Kênh kết nối</button>
        <button class="tab-btn @(activeTab == "automation" ? "active" : "")" @onclick="@(() => activeTab = "automation")">Tự động hóa</button>
        <button class="tab-btn @(activeTab == "staff" ? "active" : "")" @onclick="@(() => activeTab = "staff")">Nhân viên & Phản hồi</button>
        <button class="tab-btn @(activeTab == "webhook" ? "active" : "")" @onclick="@(() => activeTab = "webhook")">Nhật ký Webhook</button>
    </div>

    <div class="tab-content">
        @* ================= TAB: KÊNH KẾT NỐI ================= *@
        @if (activeTab == "channels")
        {
            <div class="dashboard-toolbar">
                <div class="search-box">
                    <input type="text" placeholder="Tìm kiếm trang..." />
                </div>
                <button class="btn-add-connection" @onclick="OpenAddModal">＋ Thêm kết nối</button>
            </div>

            <div class="connected-grid">
                @if (string.IsNullOrEmpty(zalo.AccessToken) && string.IsNullOrEmpty(messenger.PageAccessToken) && string.IsNullOrEmpty(shopee.AccessToken) && string.IsNullOrEmpty(tiktok.AccessToken) && string.IsNullOrEmpty(zaloPersonal.ApiKey) && string.IsNullOrEmpty(instagram.PageAccessToken))
                {
                    <div class="empty-channels">
                        <div class="empty-icon">🔌</div>
                        <p><b>Không có trang nào</b></p>
                        <p>Bạn chưa có trang nào để kích hoạt. Vui lòng chọn nền tảng và kết nối thêm trang để sử dụng.</p>
                    </div>
                }
                else
                {
                    @if (!string.IsNullOrEmpty(zalo.AccessToken))
                    {
                        <div class="connected-card">
                            <div class="card-icon ch-zalo">Z</div>
                            <div class="card-info">
                                <div class="card-name">@(string.IsNullOrEmpty(zalo.AccountName) ? "Zalo OA" : zalo.AccountName)</div>
                                <div class="card-meta">App ID: @zalo.AppId</div>
                            </div>
                            <div class="card-actions">
                                <button class="btn-icon" @onclick="@(() => OpenConfigModal("zalo"))" title="Cấu hình">⚙</button>
                            </div>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(messenger.PageAccessToken))
                    {
                        <div class="connected-card">
                            <div class="card-icon ch-messenger">F</div>
                            <div class="card-info">
                                <div class="card-name">@(string.IsNullOrEmpty(messenger.AccountName) ? "Facebook Page" : messenger.AccountName)</div>
                                <div class="card-meta">Page ID: @messenger.PageId</div>
                            </div>
                            <div class="card-actions">
                                <button class="btn-icon" @onclick="@(() => OpenConfigModal("messenger"))" title="Cấu hình">⚙</button>
                            </div>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(instagram.PageAccessToken))
                    {
                        <div class="connected-card">
                            <div class="card-icon ch-instagram">IG</div>
                            <div class="card-info">
                                <div class="card-name">@(string.IsNullOrEmpty(instagram.AccountName) ? "Instagram" : instagram.AccountName)</div>
                                <div class="card-meta">IG ID: @instagram.InstagramAccountId</div>
                            </div>
                            <div class="card-actions">
                                <button class="btn-icon" @onclick="@(() => OpenConfigModal("instagram"))" title="Cấu hình">⚙</button>
                            </div>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(shopee.AccessToken))
                    {
                        <div class="connected-card">
                            <div class="card-icon ch-shopee">S</div>
                            <div class="card-info">
                                <div class="card-name">@(string.IsNullOrEmpty(shopee.AccountName) ? "Shopee Shop" : shopee.AccountName)</div>
                                <div class="card-meta">Shop ID: @shopee.ShopId</div>
                            </div>
                            <div class="card-actions">
                                <button class="btn-icon" @onclick="@(() => OpenConfigModal("shopee"))" title="Cấu hình">⚙</button>
                            </div>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(tiktok.AccessToken))
                    {
                        <div class="connected-card">
                            <div class="card-icon ch-tiktok">T</div>
                            <div class="card-info">
                                <div class="card-name">@(string.IsNullOrEmpty(tiktok.AccountName) ? "TikTok Shop" : tiktok.AccountName)</div>
                                <div class="card-meta">Cipher: @(tiktok.ShopCipher.Length > 8 ? tiktok.ShopCipher[..8] + "..." : tiktok.ShopCipher)</div>
                            </div>
                            <div class="card-actions">
                                <button class="btn-icon" @onclick="@(() => OpenConfigModal("tiktok"))" title="Cấu hình">⚙</button>
                            </div>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(zaloPersonal.ApiKey))
                    {
                        <div class="connected-card">
                            <div class="card-icon ch-zalopersonal">Z</div>
                            <div class="card-info">
                                <div class="card-name">@(string.IsNullOrEmpty(zaloPersonal.AccountName) ? "Zalo Cá Nhân" : zaloPersonal.AccountName)</div>
                                <div class="card-meta">Sidecar: @zaloPersonal.SidecarUrl</div>
                            </div>
                            <div class="card-actions">
                                <button class="btn-icon" @onclick="@(() => OpenConfigModal("zalopersonal"))" title="Cấu hình">⚙</button>
                            </div>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(messengerPersonal.ApiKey))
                    {
                        <div class="connected-card">
                            <div class="card-icon ch-messenger">FBC</div>
                            <div class="card-info">
                                <div class="card-name">@(string.IsNullOrEmpty(messengerPersonal.AccountName) ? "Messenger Cá Nhân" : messengerPersonal.AccountName)</div>
                                <div class="card-meta">Sidecar: @messengerPersonal.SidecarUrl</div>
                            </div>
                            <div class="card-actions">
                                <button class="btn-icon" @onclick="@(() => OpenConfigModal("messengerpersonal"))" title="Cấu hình">⚙</button>
                            </div>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(threads.PageAccessToken))
                    {
                        <div class="connected-card">
                            <div class="card-icon ch-threads">TH</div>
                            <div class="card-info">
                                <div class="card-name">@(string.IsNullOrEmpty(threads.AccountName) ? "Threads" : threads.AccountName)</div>
                                <div class="card-meta">Threads ID: @threads.ThreadsAccountId</div>
                            </div>
                            <div class="card-actions">
                                <button class="btn-icon" @onclick="@(() => OpenConfigModal("threads"))" title="Cấu hình">⚙</button>
                            </div>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(googleLocation.AccessToken))
                    {
                        <div class="connected-card">
                            <div class="card-icon ch-googlelocation">G</div>
                            <div class="card-info">
                                <div class="card-name">@(string.IsNullOrEmpty(googleLocation.AccountName) ? "Google Location" : googleLocation.AccountName)</div>
                                <div class="card-meta">Location ID: @googleLocation.LocationId</div>
                            </div>
                            <div class="card-actions">
                                <button class="btn-icon" @onclick="@(() => OpenConfigModal("googlelocation"))" title="Cấu hình">⚙</button>
                            </div>
                        </div>
                    }
                }
            </div>
        }

        @* ================= TAB: TỰ ĐỘNG HÓA & AI ================= *@
        @if (activeTab == "automation")
        {
            <section class="channel-card">
                <header>
                    <span class="channel-dot" style="background:#0079bf"></span>
                    <h2>Trello — tạo thẻ khi chốt đơn</h2>
                    @if (!string.IsNullOrEmpty(trello.Token))
                    {
                        <span class="status-badge connected">Đã cấu hình</span>
                    }
                    else
                    {
                        <span class="status-badge disconnected">Chưa cấu hình</span>
                    }
                </header>
                <details class="guide">
                    <summary>📖 Cách lấy API Key, Token và List ID</summary>
                    <ol>
                        <li>Vào <a href="https://trello.com/power-ups/admin" target="_blank">trello.com/power-ups/admin</a> → <b>New</b> tạo một Power-Up (điền tên tùy ý, workspace của bạn) → mở tab <b>API key</b> → <b>Generate a new API key</b> → copy <b>API Key</b>.</li>
                        <li>Ngay cạnh API key có link <b>Token</b> (hoặc mở link sau, thay YOUR_KEY):<br />
                            <code>https://trello.com/1/authorize?expiration=never&scope=read,write&response_type=token&name=ChumChat&key=YOUR_KEY</code><br />
                            → bấm <b>Allow</b> → copy chuỗi token hiện ra.</li>
                        <li>Lấy <b>List ID</b> (ID của cột sẽ nhận thẻ, VD cột "Đơn mới"): mở board trên trình duyệt, URL dạng <code>trello.com/b/XXXX/ten-board</code> — mở tiếp địa chỉ sau (thay XXXX, KEY, TOKEN):<br />
                            <code>https://api.trello.com/1/boards/XXXX/lists?key=KEY&token=TOKEN</code><br />
                            → hiện danh sách các cột kèm <code>"id"</code> — copy id của cột muốn dùng.</li>
                        <li>Dán cả 3 giá trị vào các ô bên dưới → <b>Lưu</b>. Xong: trong Hộp thư, mỗi hội thoại có nút <b>📋 Tạo thẻ Trello</b>.</li>
                    </ol>
                </details>
                <div class="fields">
                    <label>API Key <input @bind="trello.ApiKey" placeholder="Từ trello.com/power-ups/admin" /></label>
                    <label>Token <input type="password" @bind="trello.Token" placeholder="Token đã Allow" /></label>
                    <label>List ID <input @bind="trello.ListId" placeholder="ID cột nhận thẻ (VD: Đơn mới)" /></label>
                </div>
                <div class="actions">
                    <button class="btn-save" @onclick="SaveTrello">Lưu cấu hình</button>
                </div>
            </section>



            <section class="channel-card">
                <header>
                    <span class="channel-dot" style="background:#f43f5e"></span>
                    <h2>Giao hàng Lalamove</h2>
                    @if (!string.IsNullOrEmpty(lalamove.ApiKey))
                    {
                        <span class="status-badge connected">Đã cấu hình</span>
                    }
                    else
                    {
                        <span class="status-badge disconnected">Chưa cấu hình</span>
                    }
                </header>
                <details class="guide">
                    <summary>📖 Cấu hình giao hàng Lalamove</summary>
                    <p>Nhập API Key và API Secret từ Lalamove Partner Portal để tự động gọi xe và ước tính phí ship.</p>
                </details>
                <div class="fields">
                    <label>API Key <input type="password" @bind="lalamove.ApiKey" placeholder="API Key của Lalamove" /></label>
                    <label>API Secret <input type="password" @bind="lalamove.ApiSecret" placeholder="API Secret của Lalamove" /></label>
                    <label>Tên Shop <input @bind="lalamove.SenderName" placeholder="Tên người gửi" /></label>
                    <label>SĐT Shop <input @bind="lalamove.SenderMobile" placeholder="SĐT người gửi" /></label>
                </div>
                <div class="fields" style="margin-top: 10px;">
                    <label>Loại xe
                        <select @bind="lalamove.ServiceType">
                            <option value="MOTORCYCLE">Xe máy (MOTORCYCLE)</option>
                            <option value="CAR">Ô tô (CAR)</option>
                            <option value="TRUCK500">Xe tải 500kg (TRUCK500)</option>
                        </select>
                    </label>
                    <label class="toggle-field" style="display: flex; align-items: center; gap: 8px; margin-top: 25px; font-weight: normal;">
                        <input type="checkbox" @bind="lalamove.IsSandbox" /> Thử nghiệm (Sandbox)
                    </label>
                </div>
                <label class="full-field" style="margin-top: 10px;">Địa chỉ lấy hàng mặc định
                    <textarea @bind="lalamove.SenderAddress" rows="2" placeholder="VD: 7/28 Thành Thái, Quận 10... Hoặc dán link Google Maps"></textarea>
                </label>
                <div class="actions">
                    <button class="btn-save" style="background: #f43f5e;" @onclick="SaveLalamove" disabled="@isLalamoveLoading">
                        @(isLalamoveLoading ? "Đang xử lý..." : "Lưu cấu hình Lalamove")
                    </button>
                </div>
                @if (lalamoveError is not null)
                {
                    <p class="modal-error">✕ @lalamoveError</p>
                }
            </section>
        }

        @* ================= TAB: NHÂN VIÊN & PHẢN HỒI ================= *@
        @if (activeTab == "staff")
        {
            <section class="channel-card">
                <header>
                    <span class="channel-dot" style="background:#5b21b6"></span>
                    <h2>👥 Tài khoản nhân viên</h2>
                    <span class="status-badge connected">@staffList.Count tài khoản</span>
                </header>
                <div class="staff-list">
                    @foreach (var s in staffList)
                    {
                        <div class="staff-row">
                            <span class="staff-name">@s.DisplayName <span class="staff-username">(@s.Username)</span></span>
                            @if (s.IsAdmin)
                            {
                                <span class="staff-badge admin">Admin</span>
                            }
                            @if (!s.IsActive)
                            {
                                <span class="staff-badge off">Đã khóa</span>
                            }
                            <span class="staff-actions">
                                @if (s.IsActive)
                                {
                                    <button @onclick="() => ToggleActive(s.Id, false)">Khóa</button>
                                }
                                else
                                {
                                    <button @onclick="() => ToggleActive(s.Id, true)">Mở lại</button>
                                }
                            </span>
                        </div>
                    }
                </div>
                <h4 class="sub-head">＋ Thêm nhân viên</h4>
                <div class="fields">
                    <label>Tên đăng nhập <input @bind="newStaffUsername" placeholder="vd: nhanvien1" /></label>
                    <label>Tên hiển thị <input @bind="newStaffName" placeholder="vd: Nguyễn Thị B" /></label>
                    <label>Mật khẩu <input type="password" @bind="newStaffPassword" /></label>
                    <label class="checkbox-field"><input type="checkbox" @bind="newStaffAdmin" /> Là quản trị viên</label>
                </div>
                @if (staffError is not null)
                {
                    <p class="modal-error">✕ @staffError</p>
                }
                <div class="actions">
                    <button class="btn-save" @onclick="AddStaff">Tạo tài khoản</button>
                </div>
            </section>

            <section class="channel-card">
                <header>
                    <span class="channel-dot" style="background:#0f766e"></span>
                    <h2>⚡ Câu trả lời mẫu</h2>
                    <span class="status-badge connected">@quickList.Count mẫu</span>
                </header>
                <p class="settings-hint">Các mẫu này hiện thành nút bấm nhanh ngay trên khung chat để nhân viên chèn vào tin trả lời.</p>
                <div class="quick-list">
                    @foreach (var q in quickList)
                    {
                        <div class="quick-row">
                            <span class="quick-title">@q.Title</span>
                            <span class="quick-content">@q.Content</span>
                            <button class="quick-del" @onclick="() => DeleteQuick(q.Id)" title="Xóa">✕</button>
                        </div>
                    }
                </div>
                <h4 class="sub-head">＋ Thêm mẫu</h4>
                <div class="fields">
                    <label>Tiêu đề (nút) <input @bind="newQuickTitle" placeholder="vd: Chào hỏi" /></label>
                </div>
                <label class="full-field">Nội dung
                    <textarea @bind="newQuickContent" rows="2" placeholder="vd: Dạ shop chào bạn, shop có thể giúp gì cho bạn ạ?"></textarea>
                </label>
                <div class="actions">
                    <button class="btn-save" @onclick="AddQuick">Thêm mẫu</button>
                </div>
            </section>
        }

        @* ================= TAB: NHẬT KÝ WEBHOOK ================= *@
        @if (activeTab == "webhook")
        {
            <section class="channel-card">
                <header>
                    <span class="channel-dot" style="background:#475569"></span>
                    <h2>📡 Nhật ký webhook (Hệ thống)</h2>
                    <span class="status-badge @(webhookEntries.Count > 0 ? "connected" : "disconnected")">@webhookEntries.Count sự kiện</span>
                </header>
                <p class="settings-hint">
                    Dùng để kiểm tra xem Webhook từ các kênh đã đổ về server thành công hay chưa.
                </p>
                <div class="actions" style="margin-bottom: 10px;">
                    <button class="btn-sync" @onclick="RefreshWebhookLog">🔄 Làm mới</button>
                </div>
                @if (webhookEntries.Count == 0)
                {
                    <p class="panel-empty" style="margin-top:10px">Chưa có sự kiện webhook nào kể từ khi app khởi động.</p>
                }
                else
                {
                    <div class="webhook-log">
                        @foreach (var e in webhookEntries.Take(50))
                        {
                            <div class="webhook-row @WebhookCss(e.Status)">
                                <span class="wh-time">@e.At.ToLocalTime().ToString("HH:mm:ss dd/MM")</span>
                                <span class="wh-channel">@Inbox_ChannelLabel(e.Channel)</span>
                                <span class="wh-status">@WebhookLabel(e.Status)</span>
                                <span class="wh-detail" title="@e.Detail">@e.Detail</span>
                            </div>
                        }
                    </div>
                }
            </section>
        }
    </div>
</div>

@* ================= MODAL: THÊM / CẤU HÌNH KÊNH ================= *@
@if (showChannelModal)
{
    <div class="pancake-modal-overlay" @onclick="CloseModal">
        <div class="pancake-modal" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h2>@(isEditing ? "Cấu hình kết nối" : "Thêm kết nối mới")</h2>
                <button class="btn-close" @onclick="CloseModal">✕</button>
            </div>
            <div class="modal-body">
                <!-- Cột trái: Chọn nền tảng -->
                <div class="modal-sidebar">
                    <ul class="platform-list">
                        <li class="@(modalPlatform == "zalo" ? "active" : "")" @onclick="@(() => modalPlatform = "zalo")">
                            <span class="p-icon ch-zalo">Z</span> Zalo OA
                        </li>
                        <li class="@(modalPlatform == "messenger" ? "active" : "")" @onclick="@(() => modalPlatform = "messenger")">
                            <span class="p-icon ch-messenger">F</span> Facebook Page
                        </li>
                        <li class="@(modalPlatform == "instagram" ? "active" : "")" @onclick="@(() => modalPlatform = "instagram")">
                            <span class="p-icon ch-instagram">IG</span> Instagram
                        </li>
                        <li class="@(modalPlatform == "shopee" ? "active" : "")" @onclick="@(() => modalPlatform = "shopee")">
                            <span class="p-icon ch-shopee">S</span> Shopee
                        </li>
                        <li class="@(modalPlatform == "tiktok" ? "active" : "")" @onclick="@(() => modalPlatform = "tiktok")">
                            <span class="p-icon ch-tiktok">T</span> TikTok Shop
                        </li>
                        <li class="@(modalPlatform == "zalopersonal" ? "active" : "")" @onclick="@(() => modalPlatform = "zalopersonal")">
                            <span class="p-icon ch-zalopersonal">Zp</span> Zalo Cá Nhân
                        </li>
                        <li class="@(modalPlatform == "threads" ? "active" : "")" @onclick="@(() => modalPlatform = "threads")">
                            <span class="p-icon ch-threads">TH</span> Threads
                        </li>
                        <li class="@(modalPlatform == "googlelocation" ? "active" : "")" @onclick="@(() => modalPlatform = "googlelocation")">
                            <span class="p-icon ch-googlelocation">G</span> Google Location
                        </li>
                    </ul>
                </div>

                <!-- Cột phải: Form cấu hình -->
                <div class="modal-content">
                    @if (modalPlatform == "zalo")
                    {
                        <div class="platform-header">
                            <h3>Zalo Official Account</h3>
                            @StatusBadge(zalo.AccessToken, zalo.AccountName, zalo.TokenExpiresAt)
                        </div>
                        <details class="guide">
                            <summary>📖 Cách lấy App ID và Secret Key</summary>
                            <ol>
                                <li>Cần có <b>Zalo Official Account đã xác thực</b> (tạo tại <a href="https://oa.zalo.me" target="_blank">oa.zalo.me</a> — cần giấy tờ doanh nghiệp/hộ kinh doanh).</li>
                                <li>Vào <a href="https://developers.zalo.me" target="_blank">developers.zalo.me</a>, đăng nhập bằng Zalo → <b>Thêm ứng dụng mới</b>, điền tên rồi tạo.</li>
                                <li>Trong trang ứng dụng, xem mục thông tin app: copy <b>ID ứng dụng</b> (App ID) và <b>Khóa bí mật</b> (App Secret Key).</li>
                                <li>Vào mục <b>Official Account</b> trong app → <b>Liên kết OA</b> của bạn với ứng dụng.</li>
                                <li>Vào mục <b>Cài đặt</b> → khai báo <b>Callback URL</b> bằng đúng URL hiển thị bên dưới.</li>
                                <li>Vào mục <b>Webhook</b> → copy <b>Khóa bí mật</b> của phần Webhook (OA Secret Key) → điền vào ô bên dưới cùng.</li>
                                <li>Đồng thời tại mục Webhook → nhập <b>Webhook URL</b> bên dưới, đăng ký sự kiện <b>user_send_text</b> (người dùng gửi tin nhắn).</li>
                                <li>Bấm <b>Lưu</b> rồi <b>Kết nối Zalo</b> → đăng nhập tài khoản quản trị OA và đồng ý cấp quyền.</li>
                            </ol>
                        </details>
                        <div class="fields">
                            <label>App ID <input @bind="zalo.AppId" placeholder="Từ developers.zalo.me" /></label>
                            <label>App Secret Key <input type="password" @bind="zalo.AppSecretKey" placeholder="Khóa ứng dụng (OAuth)" /></label>
                            <label>OA Secret Key <input type="password" @bind="zalo.OaSecretKey" placeholder="Khóa Webhook" /></label>
