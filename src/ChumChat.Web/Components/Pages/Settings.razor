    private static string ChannelDisplay(string key) => key switch
    {
        "zalo" => "Zalo OA",
        "messenger" => "Facebook Messenger",
        "shopee" => "Shopee",
        "tiktok" => "TikTok Shop",
        "threads" => "Threads",
        "googlelocation" => "Google Location",
        _ => key
    };

    private static T Clone<T>(T source) =>
        JsonSerializer.Deserialize<T>(JsonSerializer.Serialize(source))!;

    private RenderFragment StatusBadge(string token, string accountName, DateTime? expiresAt) => __builder =>
    {
        @if (!string.IsNullOrEmpty(token))
        {
            <span class="status-badge connected">
                Đã kết nối@(string.IsNullOrEmpty(accountName) ? "" : $": {accountName}")
                @if (expiresAt is not null)
                {
                    <em> · token hết hạn @expiresAt.Value.ToLocalTime().ToString("HH:mm dd/MM")</em>
                }
            </span>
        }
        else
        {
            <span class="status-badge disconnected">Chưa kết nối</span>
        }
    };

    private async Task SaveZalo() { await Store.SaveZaloAsync(Clone(zalo)); ShowSaved(); }
    private async Task SaveMessenger() { await Store.SaveMessengerAsync(Clone(messenger)); ShowSaved(); }
    private async Task SaveInstagram() { await Store.SaveInstagramAsync(Clone(instagram)); ShowSaved(); }
    private async Task SaveShopee() { await Store.SaveShopeeAsync(Clone(shopee)); ShowSaved(); }
    private async Task SaveTikTok() { await Store.SaveTikTokAsync(Clone(tiktok)); ShowSaved(); }
    private async Task SaveTrello() { await Store.SaveTrelloAsync(Clone(trello)); ShowSaved(); }



    private async Task SaveLalamove()
    {
        isLalamoveLoading = true;
        lalamoveError = null;
        StateHasChanged();

        try
        {
            if (string.IsNullOrWhiteSpace(lalamove.ApiKey) || string.IsNullOrWhiteSpace(lalamove.ApiSecret))
            {
                throw new Exception("Vui lòng nhập API Key và API Secret.");
            }

            // Geocode sender address
            if (!string.IsNullOrWhiteSpace(lalamove.SenderAddress))
            {
                var coords = await LalamoveSvc.GeocodeAddressAsync(lalamove.SenderAddress);
                lalamove.SenderLat = coords.Lat;
                lalamove.SenderLng = coords.Lng;
            }

            await Store.SaveLalamoveAsync(Clone(lalamove));
            ShowSaved();
        }
        catch (Exception ex)
        {
            lalamoveError = ex.Message;
        }
        finally
        {
            isLalamoveLoading = false;
        }
    }
    private async Task ConnectZaloPersonal()
    {
        syncing = true;
        banner = "Đang khởi động Zalo Sidecar và khởi tạo mã QR...";
        bannerIsError = false;
        zaloQr = null;
        StateHasChanged();
        
        await Store.SaveZaloPersonalAsync(Clone(zaloPersonal));
        await SidecarManager.EnsureZaloSidecarRunningAsync();
        zaloPersonal = Clone(Store.ZaloPersonal);

        for (int attempt = 1; attempt <= 6; attempt++)
        {
            await Task.Delay(1000);
            await CheckZaloPersonalSidecar();
            if (zaloQr != null || isZaloConnected)
            {
                break;
            }
        }
        
        StartZaloQrPollingAsync();
        syncing = false;
        StateHasChanged();
    }

    private async Task ConnectMessengerPersonal()
    {
        syncing = true;
        StateHasChanged();

        await Store.SaveMessengerPersonalAsync(Clone(messengerPersonal));
        await SidecarManager.EnsureMessengerSidecarRunningAsync();
        messengerPersonal = Clone(Store.MessengerPersonal);

        try
        {
            var client = HttpFactory.CreateClient();
            var req = new HttpRequestMessage(HttpMethod.Post, messengerPersonal.SidecarUrl.TrimEnd('/') + "/login");
            if (!string.IsNullOrEmpty(messengerPersonal.ApiKey))
                req.Headers.Add("X-Api-Key", messengerPersonal.ApiKey);
            req.Content = ZaloAdapter.JsonContent(new { appState = messengerPersonal.AppState });
            await client.SendAsync(req);
        }
        catch { /* ignore */ }

        syncing = false;
        StateHasChanged();
        ShowSaved();
    }
