                            <ol>
                                <li>Vào <a href="https://developers.facebook.com" target="_blank">developers.facebook.com</a> và đăng ký ứng dụng Threads.</li>
                                <li>Lấy <b>App ID</b> và <b>App Secret</b> của ứng dụng.</li>
                                <li>Cấp quyền và lấy <b>Threads User Access Token</b>.</li>
                                <li>Điền các thông số bên dưới để kích hoạt kết nối.</li>
                            </ol>
                        </details>
                        <div class="fields">
                            <label>App ID <input @bind="threads.AppId" placeholder="Threads App ID" /></label>
                            <label>App Secret <input type="password" @bind="threads.AppSecret" placeholder="Threads App Secret" /></label>
                            <label>Page Access Token <input type="password" @bind="threads.PageAccessToken" placeholder="Page / User Access Token" /></label>
                            <label>Threads Account ID <input @bind="threads.ThreadsAccountId" placeholder="Threads Account ID" /></label>
                            <label>Verify Token <input @bind="threads.VerifyToken" placeholder="Verify Token" /></label>
                        </div>
                        <div class="actions">
                            <button class="btn-save" @onclick="SaveThreads">Lưu cấu hình</button>
                            <button class="btn-connect" @onclick="ConnectThreads">Kết nối Threads</button>
                            @if (!string.IsNullOrEmpty(threads.PageAccessToken))
                            {
                                <button class="btn-disconnect" @onclick="DisconnectThreads">Gỡ cấu hình</button>
                            }
                        </div>
                    }

                    @if (modalPlatform == "googlelocation")
                    {
                        <div class="platform-header">
                            <h3>Google Business Location</h3>
                            @StatusBadge(googleLocation.AccessToken, googleLocation.AccountName, googleLocation.TokenExpiresAt)
                        </div>
                        <details class="guide">
                            <summary>📖 Cách lấy thông tin kết nối Google Maps / Business Profile</summary>
                            <ol>
                                <li>Tạo một dự án trên Google Cloud Console và kích hoạt <b>Google My Business Business Information API</b>.</li>
                                <li>Tạo <b>OAuth Client ID</b> và lấy <b>Client ID / Client Secret</b>.</li>
                                <li>Thực hiện OAuth cấp quyền để lấy <b>Access Token / Refresh Token</b>.</li>
                                <li>Điền <b>Account ID</b> và <b>Location ID</b> địa điểm của bạn từ Google Business Profile.</li>
                            </ol>
                        </details>
                        <div class="fields">
                            <label>API Key <input @bind="googleLocation.ApiKey" placeholder="API Key" /></label>
                            <label>Client ID <input @bind="googleLocation.ClientId" placeholder="Google OAuth Client ID" /></label>
                            <label>Client Secret <input type="password" @bind="googleLocation.ClientSecret" placeholder="Google OAuth Client Secret" /></label>
                            <label>Access Token <input type="password" @bind="googleLocation.AccessToken" placeholder="Access Token" /></label>
                            <label>Refresh Token <input type="password" @bind="googleLocation.RefreshToken" placeholder="Refresh Token" /></label>
                            <label>Account ID <input @bind="googleLocation.AccountId" placeholder="Account ID (ví dụ: accounts/123...)" /></label>
                            <label>Location ID <input @bind="googleLocation.LocationId" placeholder="Location ID (ví dụ: locations/456...)" /></label>
                        </div>
                        <div class="actions">
                            <button class="btn-save" @onclick="SaveGoogleLocation">Lưu cấu hình</button>
                            @if (!string.IsNullOrEmpty(googleLocation.AccessToken))
                            {
                                <button class="btn-disconnect" @onclick="DisconnectGoogleLocation">Gỡ cấu hình</button>
                            }
                        </div>
                    }

                    @if (testResults.TryGetValue(GetChannelType(modalPlatform), out var testRes))
                    {
                        <p class="test-result @(testRes.Ok ? "ok" : "fail")" style="margin-top: 15px;">@(testRes.Ok ? "✔ " : "✕ ")@testRes.Message</p>
                    }
                    
                    @if (isEditing)
                    {
                        <div style="margin-top: 20px; border-top: 1px solid #eee; padding-top: 15px;">
                            <button class="btn-sync" @onclick="() => TestConnection(GetChannelType(modalPlatform))" disabled="@testing">🔎 Kiểm tra API</button>
                            <button class="btn-sync" @onclick="() => SyncHistory(GetChannelType(modalPlatform))" disabled="@syncing">
                                @(syncing ? "Đang đồng bộ…" : "⟳ Đồng bộ tin cũ")
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}
</div>

@code {
    private async Task ToggleAiAutoReplyAsync()
