                                <li>Bấm <b>Lưu</b> rồi <b>Kết nối Instagram</b> → đăng nhập bằng Facebook và cấp quyền.</li>
                            </ol>
                        </details>
                        <div class="fields">
                            <label>App ID <input @bind="instagram.AppId" placeholder="Từ developers.facebook.com" /></label>
                            <label>App Secret <input type="password" @bind="instagram.AppSecret" placeholder="Khóa bí mật của app" /></label>
                            <label>Verify Token <input @bind="instagram.VerifyToken" placeholder="Chuỗi tự đặt cho webhook" /></label>
