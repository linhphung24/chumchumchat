    private async Task AddStaff()
    {
        staffError = null;
        var (ok, error) = await StaffSvc.CreateAsync(newStaffUsername, newStaffName, newStaffPassword, newStaffAdmin);
        if (!ok)
        {
            staffError = error;
            return;
        }
        newStaffUsername = newStaffName = newStaffPassword = "";
        newStaffAdmin = false;
        staffList = await StaffSvc.GetAllAsync();
        ShowSaved();
    }

