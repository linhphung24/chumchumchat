                                    <button type="button" class="btn-sync" @onclick="ConnectZaloPersonal" style="width: 100%; padding: 10px 18px; border-radius: 10px; background: #0068ff; color: white; border: none; font-size: 14px; font-weight: 700; cursor: pointer; box-shadow: 0 2px 8px rgba(0,104,255,0.25);">
