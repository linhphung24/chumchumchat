@page "/doi-mat-khau"
@attribute [Authorize]
@rendermode InteractiveServer
@using ChumChat.Web.Services
@inject StaffService StaffSvc
@inject AuthenticationStateProvider AuthState

<PageTitle>Đổi mật khẩu — ChumChat</PageTitle>

<div class="simulator">
    <div class="settings-header">
        <h1>🔑 Đổi mật khẩu</h1>
        <a href="/">← Về Hộp thư</a>
    </div>

    @if (done)
    {
        <p class="sent-note">✔ Đã đổi mật khẩu thành công.</p>
    }
    @if (error is not null)
    {
        <p class="modal-error">✕ @error</p>
    }

    <div class="sim-form">
        <label>Mật khẩu mới
            <input type="password" @bind="pw1" />
        </label>
        <label>Nhập lại mật khẩu mới
            <input type="password" @bind="pw2" />
        </label>
        <button @onclick="Save" disabled="@(string.IsNullOrWhiteSpace(pw1))">Lưu mật khẩu</button>
    </div>
</div>

@code {
    private string pw1 = "", pw2 = "";
    private bool done;
    private string? error;

    private async Task Save()
    {
        error = null;
        done = false;
        if (pw1.Length < 4)
        {
            error = "Mật khẩu tối thiểu 4 ký tự";
            return;
        }
        if (pw1 != pw2)
        {
            error = "Hai lần nhập không khớp";
            return;
        }
        var authState = await AuthState.GetAuthenticationStateAsync();
        if (int.TryParse(authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out var id))
        {
            await StaffSvc.ChangePasswordAsync(id, pw1);
            pw1 = pw2 = "";
            done = true;
        }
    }
}
