@code {
    private List<Product> products = [];
    private string statusFilter = "all";
    private bool isSyncing = false;
    private string? banner;
    private bool bannerIsError;

    private bool showAddModal = false;
    private Product newProduct = new() { StockQuantity = 999, IsActive = true };

    private async Task ToggleAiAutoReplyAsync()
    {
        Store.Ai.IsAutoReplyEnabled = !Store.Ai.IsAutoReplyEnabled;
        await Store.SaveAiAsync(Store.Ai);
        StateHasChanged();
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadProducts();
    }

    private async Task LoadProducts()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        products = await db.Products.OrderByDescending(p => p.IsActive).ThenBy(p => p.Name).ToListAsync();
    }

    private string searchInput = "";
    private string appliedSearchQuery = "";

    // Pagination state
    private int currentPage = 1;
    private int pageSize = 20;

    private int TotalPages => pageSize > 0 ? Math.Max(1, (int)Math.Ceiling((double)FilteredProducts.Count / pageSize)) : 1;
    private int StartItemIndex => FilteredProducts.Count == 0 ? 0 : (pageSize > 0 ? (currentPage - 1) * pageSize + 1 : 1);
    private int EndItemIndex => pageSize > 0 ? Math.Min(currentPage * pageSize, FilteredProducts.Count) : FilteredProducts.Count;

    private List<Product> PagedProducts => pageSize > 0
        ? FilteredProducts.Skip((currentPage - 1) * pageSize).Take(pageSize).ToList()
        : FilteredProducts;

    private void SetPage(int page)
    {
        if (page < 1) page = 1;
        if (page > TotalPages) page = TotalPages;
        currentPage = page;
        StateHasChanged();
    }

    private void ChangePageSize(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var size))
        {
            pageSize = size;
            currentPage = 1;
            StateHasChanged();
        }
    }

    private void OnStatusFilterChanged()
    {
        currentPage = 1;
        StateHasChanged();
    }

    private void HandleSearchKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            ApplySearch();
        }
    }

    private void ApplySearch()
    {
        appliedSearchQuery = searchInput.Trim();
        currentPage = 1;
        StateHasChanged();
    }

    private void ClearSearch()
    {
        searchInput = "";
        appliedSearchQuery = "";
        currentPage = 1;
        StateHasChanged();
    }

    private List<Product> FilteredProducts => products.Where(p =>
    {
        // Filter by Search Query (không phụ thuộc thứ tự từ và không phân biệt dấu tiếng Việt)
        if (!string.IsNullOrWhiteSpace(appliedSearchQuery))
        {
            var normQuery = RemoveDiacritics(appliedSearchQuery);
            var queryWords = normQuery.Split(' ', StringSplitOptions.RemoveEmptyEntries);

            var normName = RemoveDiacritics(p.Name);
            var normSku = RemoveDiacritics(p.Sku);
            var normDesc = RemoveDiacritics(p.Description);

            var isMatch = queryWords.All(w => normName.Contains(w) || normSku.Contains(w) || normDesc.Contains(w));
            if (!isMatch) return false;
        }

        // Filter by Status
        return statusFilter switch
        {
            "active" => p.IsActive,
            "instock" => p.IsActive && p.StockQuantity > 0,
            "outofstock" => p.IsActive && p.StockQuantity <= 0,
            "inactive" => !p.IsActive,
            _ => true
        };
    }).ToList();

    private static string RemoveDiacritics(string text)
    {
        if (string.IsNullOrWhiteSpace(text)) return "";
        text = text.ToLowerInvariant().Replace('đ', 'd');
        var normalizedString = text.Normalize(System.Text.NormalizationForm.FormD);
        var stringBuilder = new System.Text.StringBuilder();
        foreach (var c in normalizedString)
        {
            var unicodeCategory = System.Globalization.CharUnicodeInfo.GetUnicodeCategory(c);
            if (unicodeCategory != System.Globalization.UnicodeCategory.NonSpacingMark)
            {
                stringBuilder.Append(c);
            }
        }
        return stringBuilder.ToString().Normalize(System.Text.NormalizationForm.FormC).Trim();
    }

    private async Task SyncFromIpos()
    {
        isSyncing = true;
        banner = null;
        try
        {
            var res = await IposSync.SyncMenuAsync();
            banner = $"✔ Đã đồng bộ xong {res.Total} món ăn từ iPOS! (Thêm mới {res.NewCount}, Cập nhật {res.UpdatedCount})";
            bannerIsError = false;
            await LoadProducts();
        }
        catch (Exception ex)
        {
            banner = $"✕ Lỗi đồng bộ iPOS: {ex.Message}";
            bannerIsError = true;
        }
        finally
        {
            isSyncing = false;
        }
    }

    private async Task SaveProduct(Product p)
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            db.Products.Update(p);
            await db.SaveChangesAsync();
            banner = $"✔ Đã lưu thông tin món '{p.Name}' (Tồn kho: {p.StockQuantity})";
            bannerIsError = false;
        }
        catch (Exception ex)
        {
            banner = $"✕ Lỗi lưu sản phẩm: {ex.Message}";
            bannerIsError = true;
        }
    }

    private async Task AdjustStock(Product p, int delta)
    {
        p.StockQuantity = Math.Max(0, p.StockQuantity + delta);
        await SaveProduct(p);
    }

    private async Task ToggleActive(Product p)
    {
        p.IsActive = !p.IsActive;
        await SaveProduct(p);
    }

    private async Task DeleteProduct(Product p)
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            db.Products.Remove(p);
            await db.SaveChangesAsync();
            products.Remove(p);
            banner = $"✔ Đã xóa món '{p.Name}' khỏi danh mục";
            bannerIsError = false;
        }
        catch (Exception ex)
        {
            banner = $"✕ Lỗi xóa sản phẩm: {ex.Message}";
            bannerIsError = true;
        }
    }

    private void OpenAddModal()
    {
        newProduct = new Product { StockQuantity = 999, IsActive = true };
        showAddModal = true;
    }

    private void CloseAddModal() => showAddModal = false;

    private async Task CreateProduct()
    {
        if (string.IsNullOrWhiteSpace(newProduct.Name))
        {
            banner = "✕ Vui lòng nhập tên sản phẩm!";
            bannerIsError = true;
            return;
        }

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            db.Products.Add(newProduct);
            await db.SaveChangesAsync();
            showAddModal = false;
            banner = $"✔ Đã tạo mới sản phẩm '{newProduct.Name}'!";
            bannerIsError = false;
            await LoadProducts();
        }
        catch (Exception ex)
        {
            banner = $"✕ Lỗi tạo món mới: {ex.Message}";
            bannerIsError = true;
        }
    }

    // ===== EXPORT & IMPORT EXCEL / CSV =====

    private async Task ExportExcelCsv()
    {
        try
        {
            var sb = new System.Text.StringBuilder();
            // BOM cho UTF-8 để Microsoft Excel nhận diện Tiếng Việt không lỗi font
            sb.Append("\uFEFF");
            sb.AppendLine("Id,Tên Món,Giá Bán,Mô Tả,Số Lượng Tồn,Trạng Thái (1: Bán / 0: Ngừng)");

            foreach (var p in products)
            {
                var nameEsc = EscapeCsvField(p.Name);
                var descEsc = EscapeCsvField(p.Description);
                var isActiveNum = p.IsActive ? 1 : 0;
                sb.AppendLine($"{p.Id},{nameEsc},{p.Price:F0},{descEsc},{p.StockQuantity},{isActiveNum}");
            }

            var fileName = $"Thuc_Don_ChumChat_{DateTime.Now:yyyyMMdd_HHmmss}.csv";
            var bytes = System.Text.Encoding.UTF8.GetBytes(sb.ToString());
            var base64 = Convert.ToBase64String(bytes);

            await JS.InvokeVoidAsync("eval", $@"
                (function() {{
                    const link = document.createElement('a');
                    link.download = '{fileName}';
                    link.href = 'data:text/csv;charset=utf-8;base64,{base64}';
                    document.body.appendChild(link);
                    link.click();
                    document.body.removeChild(link);
                }})();
            ");

            banner = $"✔ Đã xuất {products.Count} món ra file Excel/CSV thành công!";
            bannerIsError = false;
        }
        catch (Exception ex)
        {
            banner = $"✕ Lỗi xuất file: {ex.Message}";
            bannerIsError = true;
        }
    }

    private static string EscapeCsvField(string field)
    {
        if (string.IsNullOrEmpty(field)) return "";
        if (field.Contains(',') || field.Contains('"') || field.Contains('\n') || field.Contains('\r'))
        {
            return $"\"{field.Replace("\"", "\"\"")}\"";
        }
        return field;
    }

    private async Task OnCsvFileUploaded(InputFileChangeEventArgs e)
    {
        try
        {
            var file = e.File;
            if (file == null) return;

            using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            using var reader = new System.IO.StreamReader(stream, System.Text.Encoding.UTF8);
            var content = await reader.ReadToEndAsync();

            var lines = ParseCsvLines(content);
            if (lines.Count <= 1)
            {
                banner = "✕ File không chứa dữ liệu sản phẩm hợp lệ!";
                bannerIsError = true;
                return;
            }

            await using var db = await DbFactory.CreateDbContextAsync();
            var existingProducts = await db.Products.ToDictionaryAsync(p => p.Id);

            int updatedCount = 0;
            int addedCount = 0;

            // Bỏ dòng tiêu đề (Index 0)
            for (int i = 1; i < lines.Count; i++)
            {
                var cols = lines[i];
                if (cols.Count < 2) continue;

                int.TryParse(cols[0].Trim(), out var id);
                var name = cols.Count > 1 ? cols[1].Trim() : "";
                if (string.IsNullOrWhiteSpace(name)) continue;

                long.TryParse(cols.Count > 2 ? cols[2].Trim() : "0", out var price);
                var desc = cols.Count > 3 ? cols[3].Trim() : "";
                int.TryParse(cols.Count > 4 ? cols[4].Trim() : "999", out var stock);
                var activeStr = cols.Count > 5 ? cols[5].Trim() : "1";
                bool isActive = activeStr == "1" || activeStr.Equals("true", StringComparison.OrdinalIgnoreCase);

                if (id > 0 && existingProducts.TryGetValue(id, out var pExisting))
                {
                    // Cập nhật sản phẩm đã có
                    pExisting.Name = name;
                    pExisting.Price = price;
                    pExisting.Description = desc;
                    pExisting.StockQuantity = stock;
                    pExisting.IsActive = isActive;
                    db.Products.Update(pExisting);
                    updatedCount++;
                }
                else
                {
                    // Thêm sản phẩm mới
                    var pNew = new Product
                    {
                        Name = name,
                        Price = price,
                        Description = desc,
                        StockQuantity = stock,
                        IsActive = isActive
                    };
                    db.Products.Add(pNew);
                    addedCount++;
                }
            }

            await db.SaveChangesAsync();
            await LoadProducts();

            banner = $"✔ Đã import thành công! (Cập nhật {updatedCount} món, Thêm mới {addedCount} món)";
            bannerIsError = false;
        }
        catch (Exception ex)
        {
            banner = $"✕ Lỗi import file: {ex.Message}";
            bannerIsError = true;
        }
    }

    private static List<List<string>> ParseCsvLines(string text)
    {
        var result = new List<List<string>>();
        if (string.IsNullOrWhiteSpace(text)) return result;

        if (text.StartsWith("\uFEFF")) text = text[1..];

        var currentLine = new List<string>();
        var currentToken = new System.Text.StringBuilder();
        bool inQuotes = false;

        for (int i = 0; i < text.Length; i++)
        {
            char c = text[i];

            if (inQuotes)
            {
                if (c == '"')
                {
                    if (i + 1 < text.Length && text[i + 1] == '"')
                    {
                        currentToken.Append('"');
                        i++;
                    }
                    else
                    {
                        inQuotes = false;
                    }
                }
                else
                {
                    currentToken.Append(c);
                }
            }
            else
            {
                if (c == '"')
                {
                    inQuotes = true;
                }
                else if (c == ',')
                {
                    currentLine.Add(currentToken.ToString());
                    currentToken.Clear();
                }
                else if (c == '\r')
                {
                    if (i + 1 < text.Length && text[i + 1] == '\n') i++;
                    currentLine.Add(currentToken.ToString());
                    currentToken.Clear();
                    if (currentLine.Any(s => !string.IsNullOrWhiteSpace(s)))
                        result.Add(currentLine);
                    currentLine = new List<string>();
                }
                else if (c == '\n')
                {
                    currentLine.Add(currentToken.ToString());
                    currentToken.Clear();
                    if (currentLine.Any(s => !string.IsNullOrWhiteSpace(s)))
                        result.Add(currentLine);
                    currentLine = new List<string>();
                }
                else
                {
                    currentToken.Append(c);
                }
            }
        }

        if (currentToken.Length > 0 || currentLine.Count > 0)
        {
            currentLine.Add(currentToken.ToString());
            if (currentLine.Any(s => !string.IsNullOrWhiteSpace(s)))
                result.Add(currentLine);
        }

        return result;
    }
}
