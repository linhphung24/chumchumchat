    protected override async Task OnInitializedAsync()
    {
        ai = Clone(Store.Ai);
        if (string.IsNullOrEmpty(ai.Provider))
            ai.Provider = "anthropic";
        if (string.IsNullOrWhiteSpace(ai.OllamaUrl))
            ai.OllamaUrl = "http://localhost:11434";
            
        // Phân rã ShopContext thành 3 phần nếu là JSON
        if (!string.IsNullOrWhiteSpace(ai.ShopContext))
        {
            try
            {
                using var doc = System.Text.Json.JsonDocument.Parse(ai.ShopContext);
                var root = doc.RootElement;
                if (root.ValueKind == System.Text.Json.JsonValueKind.Object)
                {
                    shopInfo = root.TryGetProperty("shopInfo", out var info) ? info.GetString() ?? "" : "";
                    deliveryProcess = root.TryGetProperty("deliveryProcess", out var dev) ? dev.GetString() ?? "" : "";
                    aiTone = root.TryGetProperty("aiTone", out var tone) ? tone.GetString() ?? "" : "";
                    systemRules = root.TryGetProperty("systemRules", out var sRules) ? sRules.GetString() ?? "" : "";
                }
                else
                {
                    shopInfo = ai.ShopContext;
                }
            }
            catch
            {
                shopInfo = ai.ShopContext;
            }
        }

        faqs = await Knowledge.GetFaqsAsync();
        images = await Knowledge.GetImagesAsync();
        rules = await AutoReply.GetAllAsync();
    }

    private void ChooseProvider(string key)
    {
        if (ai.Provider == key)
            return;
        ai.Provider = key;
        // Đổi nhà cung cấp thì đổi model mặc định
        ai.Model = DefaultModel.TryGetValue(key, out var m) ? m : "qwen2.5";
        if (key != "ollama")
        {
            ai.ApiKey = "";
        }
        if (key == "ollama" && string.IsNullOrWhiteSpace(ai.OllamaUrl))
        {
            ai.OllamaUrl = "http://localhost:11434";
        }
    }

    private async Task SaveConnection()
    {
        var contextObj = new { shopInfo, deliveryProcess, aiTone, systemRules };
        ai.ShopContext = System.Text.Json.JsonSerializer.Serialize(contextObj);
        
        await Store.SaveAiAsync(Clone(ai));
        banner = "✔ Đã lưu thông tin & quy tắc tư vấn AI!";
        bannerIsError = false;
    }

    private async Task AddFaq()
    {
        if (string.IsNullOrWhiteSpace(newFaqQuestion) || string.IsNullOrWhiteSpace(newFaqAnswer))
            return;
        await Knowledge.AddFaqAsync(newFaqQuestion, newFaqAnswer);
        newFaqQuestion = newFaqAnswer = "";
        faqs = await Knowledge.GetFaqsAsync();
    }

    private async Task DeleteFaq(int id)
    {
        await Knowledge.DeleteFaqAsync(id);
        faqs = await Knowledge.GetFaqsAsync();
    }

    private async Task OnImageUpload(InputFileChangeEventArgs e)
    {
        if (uploading)
            return;
        uploading = true;
        imageError = null;
        try
        {
            var file = e.File;
            var ext = Path.GetExtension(file.Name);
            if (string.IsNullOrEmpty(ext) || ext.Length > 5)
                ext = ".jpg";
            var fileName = $"{Guid.NewGuid():N}{ext}";
            var dir = Path.Combine(HostEnv.WebRootPath, "uploads", "ai");
            Directory.CreateDirectory(dir);

            await using (var target = File.Create(Path.Combine(dir, fileName)))
            await using (var source = file.OpenReadStream(maxAllowedSize: 15 * 1024 * 1024))
            {
                await source.CopyToAsync(target);
            }

            await Knowledge.AddImageAsync($"/uploads/ai/{fileName}", newImageCaption);
            newImageCaption = "";
            images = await Knowledge.GetImagesAsync();
        }
        catch (Exception ex)
        {
            imageError = ex.Message;
        }
        finally
        {
            uploading = false;
        }
    }

    private async Task DeleteImage(int id)
    {
        await Knowledge.DeleteImageAsync(id);
        images = await Knowledge.GetImagesAsync();
    }

    // ===== Kịch bản tự động gửi file =====

    private async Task OnRuleFileSelected(InputFileChangeEventArgs e)
    {
        ruleError = null;
        try
        {
            var file = e.File;
            var ext = Path.GetExtension(file.Name);
            if (string.IsNullOrEmpty(ext) || ext.Length > 6)
                ext = ".pdf";
            var fileName = $"{Guid.NewGuid():N}{ext}";
            var dir = Path.Combine(HostEnv.WebRootPath, "uploads", "auto");
            Directory.CreateDirectory(dir);

            await using (var target = File.Create(Path.Combine(dir, fileName)))
            await using (var source = file.OpenReadStream(maxAllowedSize: 25 * 1024 * 1024))
            {
                await source.CopyToAsync(target);
            }

            ruleFileUrl = $"/uploads/auto/{fileName}";
            ruleFileName = file.Name;
            ruleFileMime = string.IsNullOrEmpty(file.ContentType) ? GuessMime(ext) : file.ContentType;
        }
        catch (Exception ex)
        {
            ruleError = ex.Message;
        }
    }

    private static string GuessMime(string ext) => ext.ToLowerInvariant() switch
    {
        ".pdf" => "application/pdf",
        ".png" => "image/png",
        ".gif" => "image/gif",
        ".webp" => "image/webp",
        ".jpg" or ".jpeg" => "image/jpeg",
        _ => "application/octet-stream"
    };

    private async Task AddRule()
    {
        if (string.IsNullOrWhiteSpace(newRuleName) || (string.IsNullOrWhiteSpace(newRuleReplyText) && ruleFileUrl is null))
            return;
        savingRule = true;
        ruleError = null;
        try
        {
            await AutoReply.SaveAsync(new AutoReplyRule
            {
                Name = newRuleName.Trim(),
                Keywords = newRuleKeywords.Trim(),
                MatchDescription = newRuleDesc.Trim(),
                ReplyText = newRuleReplyText.Trim(),
                FileUrl = ruleFileUrl ?? "",
                FileName = ruleFileName ?? "",
                FileMime = ruleFileMime ?? "",
                Enabled = true
            });
            newRuleName = newRuleKeywords = newRuleDesc = newRuleReplyText = "";
            ruleFileUrl = ruleFileName = ruleFileMime = null;
            rules = await AutoReply.GetAllAsync();
        }
        catch (Exception ex)
        {
            ruleError = ex.Message;
        }
        finally
        {
            savingRule = false;
        }
    }

    private async Task ToggleRule(int id, bool enabled)
    {
        await AutoReply.SetEnabledAsync(id, enabled);
        rules = await AutoReply.GetAllAsync();
    }

    private async Task DeleteRule(int id)
    {
        await AutoReply.DeleteAsync(id);
        rules = await AutoReply.GetAllAsync();
    }

    private async Task ToggleAiAutoReplyAsync()
    {
        ai.IsAutoReplyEnabled = !ai.IsAutoReplyEnabled;
        await Store.SaveAiAsync(ai);
        banner = ai.IsAutoReplyEnabled ? "✔ Đã BẬT AI tự động trả lời & chốt đơn!" : "⏸️ Đã TẮT AI tự động trả lời!";
        bannerIsError = false;
        StateHasChanged();
    }

    private static T Clone<T>(T source) =>
        System.Text.Json.JsonSerializer.Deserialize<T>(System.Text.Json.JsonSerializer.Serialize(source))!;
