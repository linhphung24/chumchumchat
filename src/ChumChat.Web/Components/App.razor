<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    @* Xác thực sở hữu domain chat.chumchumbakery.com với Zalo Platform (developers.zalo.me > Xác thực domain) *@
    <meta name="zalo-platform-site-verification" content="UlYFSx_f6r9aueDnvFSbAI3XiJNCbsHYDZGu" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["ChumChat.Web.styles.css"]" />
    
    <!-- PWA Manifest & Meta Tags -->
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#ff5722" />
    
    <!-- iOS Support -->
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="ChumChat" />
    <link rel="apple-touch-icon" href="/icon-192.png" />

    <ImportMap />
    <HeadOutlet />
</head>

<body>
    <Routes />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script>
        window.scrollToBottom = function(elementId) {
            var el = document.getElementById(elementId);
            if (el) {
                el.scrollTop = el.scrollHeight;
            }
        };

        // Register Service Worker
        if ('serviceWorker' in navigator) {
            navigator.serviceWorker.register('/service-worker.js')
                .then(function(reg) { console.log('ServiceWorker registered'); })
                .catch(function(err) { console.error('ServiceWorker registration failed', err); });
        }

        // Web Push Helper functions
        window.requestNotificationPermission = async function() {
            return await Notification.requestPermission();
        };

        window.getPushSubscriptionStatus = async function() {
            if (!('serviceWorker' in navigator)) return 'NoServiceWorker';
            try {
                const reg = await navigator.serviceWorker.ready;
                const sub = await reg.pushManager.getSubscription();
                return sub ? 'Subscribed' : 'NotSubscribed';
            } catch (err) {
                console.error('Error checking subscription', err);
                return 'NotSubscribed';
            }
        };

        window.subscribeUserToPush = async function(vapidPublicKey) {
            if (!('serviceWorker' in navigator)) throw new Error('Service Worker not supported');
            
            const reg = await navigator.serviceWorker.ready;
            
            // Helper convert base64 VAPID to Uint8Array
            function urlBase64ToUint8Array(base64String) {
                const padding = '='.repeat((4 - base64String.length % 4) % 4);
                const base64 = (base64String + padding).replace(/\-/g, '+').replace(/_/g, '/');
                const rawData = window.atob(base64);
                const outputArray = new Uint8Array(rawData.length);
                for (let i = 0; i < rawData.length; ++i) {
                    outputArray[i] = rawData.charCodeAt(i);
                }
                return outputArray;
            }

            const applicationServerKey = urlBase64ToUint8Array(vapidPublicKey);
            const subscription = await reg.pushManager.subscribe({
                userVisibleOnly: true,
                applicationServerKey: applicationServerKey
            });

            // toJSON() trả về keys đã mã hóa base64url đúng chuẩn WebPush
            const subJson = subscription.toJSON();
            return JSON.stringify({
                endpoint: subJson.endpoint,
                p256dh: subJson.keys.p256dh,
                auth: subJson.keys.auth
            });
        };

        window.unsubscribeUserFromPush = async function() {
            if (!('serviceWorker' in navigator)) return null;
            const reg = await navigator.serviceWorker.ready;
            const sub = await reg.pushManager.getSubscription();
            if (sub) {
                const endpoint = sub.endpoint;
                await sub.unsubscribe();
                return endpoint;
            }
            return null;
        };

        window.printReceiptDiv = function(divId) {
            var element = document.getElementById(divId);
            if (!element) return;
            var printWin = window.open('', '_blank', 'width=400,height=650');
            printWin.document.write('<html><head><title>Hóa đơn iPOS - Chum Chum Bakery</title><style>body { font-family: "Courier New", Courier, monospace; margin: 0; padding: 10px; background: #fff; } @@page { size: 80mm auto; margin: 0; }</style></head><body>');
            printWin.document.write(element.innerHTML);
            printWin.document.write('</body></html>');
            printWin.document.close();
            printWin.focus();
            setTimeout(function() {
                printWin.print();
                printWin.close();
            }, 300);
        };
    </script>
</body>

</html>
